# Copy this file to .env.local and fill in real values. .env.local is in
# .gitignore and must never be committed. Nothing in this file is a usable
# secret -- every value below is either a placeholder or an instruction for
# generating one.

# ---------------------------------------------------------------------------
# Database (Prisma / PostgreSQL)
# ---------------------------------------------------------------------------
# Standard connection string for queries/migrations.
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/willsgrove?schema=public"
# Same database, used by Prisma for the direct (non-pooled) connection
# migrations need. If you are not using a connection pooler, this can be
# identical to DATABASE_URL.
DIRECT_URL="postgresql://USER:PASSWORD@localhost:5432/willsgrove?schema=public"

# ---------------------------------------------------------------------------
# Auth
# ---------------------------------------------------------------------------
# Signs/verifies the session cookie (HS256). Must be a long random value and
# must stay the same across restarts, or every existing session is
# invalidated. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET=""

# Origin this app is served from. Used by the CSRF check (lib/auth/csrf.ts)
# to verify the Origin/Referer header on cookie-authenticated mutating
# requests, so it must exactly match the URL you actually run the app at
# (scheme + host + port). No trailing slash.
APP_BASE_URL="http://localhost:3000"

# ---------------------------------------------------------------------------
# Seed admin (prisma/seed.ts)
# ---------------------------------------------------------------------------
# The one administrator account the seed script creates. Required -- the
# seed refuses to run without both set, and refuses a weak password (see
# checkPasswordStrength in lib/auth/password.ts). The seeded admin has
# mustChangePassword=true, so this password only needs to work for the
# very first login.
SEED_ADMIN_EMAIL="admin@yourcompany.example"
SEED_ADMIN_PASSWORD=""

# ---------------------------------------------------------------------------
# File storage (order document uploads)
# ---------------------------------------------------------------------------
STORAGE_DRIVER="local"
# Absolute path to a directory OUTSIDE this project folder, so uploaded
# files are never inside anything git (or your deploy pipeline) might
# touch. The directory is created on first use if it doesn't exist; the
# app's OS user needs read/write access to it.
#   Windows example: C:\willsgrove-storage
#   macOS/Linux example: /var/lib/willsgrove/storage
STORAGE_LOCAL_DIR=""

# ---------------------------------------------------------------------------
# PO extraction (Milestone 2A -- PO intake + extraction)
# ---------------------------------------------------------------------------
# Real key from https://platform.claude.com -- used ONLY server-side
# (lib/extraction/providers/anthropic.ts), never sent to the browser. Used
# for PDF/image PO documents and pasted WhatsApp/email text. Leave blank to
# develop/test entirely against the deterministic mock provider -- nothing
# in this milestone requires a key to run.
ANTHROPIC_API_KEY=""
# Optional. Defaults to claude-sonnet-5-5 if unset.
ANTHROPIC_MODEL=""
# Optional. Set to "mock" to force the deterministic mock extraction
# provider even when ANTHROPIC_API_KEY is set (useful for predictable
# demos/tests without spending real API usage). Leave unset/blank for the
# normal behavior: real provider when a key is configured, mock otherwise.
EXTRACTION_PROVIDER=""

# ---------------------------------------------------------------------------
# SAP Business One integration (Milestone 9)
# ---------------------------------------------------------------------------
# Deployment-level kill switch -- the ONLY way to ever activate the real
# SAP Service Layer adapter. Any value other than exactly "live"
# (case-sensitive) is treated as "mock", so a typo or an unset variable
# always fails safe to the deterministic mock adapter -- see
# lib/integrations/sap/config.ts. Leave unset/blank in every environment
# until docs/sap-integration/discovery-checklist.md is fully complete AND
# an ADMINISTRATOR has separately set IntegrationConnection.mode to LIVE
# and enabled it from /integrations/sap/settings -- both must agree, or
# this app still talks only to the mock adapter.
SAP_B1_PROVIDER=""
# The SAP Service Layer service account's password. Lives ONLY here --
# never in the database, never in a log, never returned by any API
# response (see lib/integrations/sap/config.ts's module comment). The
# account's base URL/company DB/username are configured separately,
# in-app, via /integrations/sap/settings (ADMINISTRATOR-only), not as
# environment variables -- only the secret itself lives in the
# environment.
SAP_B1_PASSWORD=""

# ---------------------------------------------------------------------------
# Misc
# ---------------------------------------------------------------------------
NODE_ENV="development"
