model AuditEvent {
  id      String  @id @default(cuid())
  actorId String?

  action     String
  entityType String
  entityId   String

  beforeData Json?
  afterData  Json?

  createdAt DateTime @default(now()) @db.Timestamptz(6)

  actor User? @relation("AuditActor", fields: [actorId], references: [id], onDelete: Restrict)

  @@index([entityType, entityId])
  @@index([actorId])
  @@index([createdAt])
