generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum UserRole {
  SALESPERSON
  SALES_MANAGER
  ADMINISTRATOR
}

enum RecordStatus {
  ACTIVE
  INACTIVE
}

// Milestone 2A (PO intake + extraction). EMAIL/WHATSAPP were already here
// (Milestone 0) and now specifically mean "pasted text from that channel"
// -- PDF/IMAGE/EXCEL/CSV are the new upload-based channels. This is the
// one enum for "how did this PO arrive," reused on both OrderDocument
// (set at intake, before a customer/order exists) and CustomerOrder (set
// once the order itself is created) rather than inventing a second,
// parallel channel enum -- see docs/milestones/PROGRESS.md for why.
enum OrderSource {
  EMAIL
  WHATSAPP
  MANUAL
  PDF
  IMAGE
  EXCEL
  CSV
  // Milestone 7 (Quotations Management). Set only by
  // lib/quotations/convert-to-order.ts when a CustomerOrder is created
  // FROM an accepted Quotation -- never set any other way. Deliberately
  // not reusing MANUAL: that would lose the one fact this value exists
  // to preserve (spec section 8's "maintain a traceable relationship
  // between the quotation and the resulting order"), which the new
  // CustomerOrder.sourceQuotation relation already carries structurally,
  // but a reconciliation/reporting query over OrderSource alone should
  // not have to join Quotation just to tell these orders apart from a
  // plain manually-keyed one.
  QUOTATION
}

enum OrderStatus {
  DRAFT
  RECEIVED
  PENDING_VERIFICATION
  READY_FOR_APPROVAL
  APPROVED
  // Milestone 3A. Set once a PickingSession is started for this order
  // (lib/picking/start-picking.ts) and held until that session is
  // authorized. Deliberately NOT part of the READY_FOR_APPROVAL/APPROVED
  // sequence above -- that sequence belongs to the separate, still-unbuilt
  // SAP-catalogue/price-verification and discount-approval workflow
  // (VerificationStatus/PriceDecisionStatus/OrderApproval below), which is
  // not the same thing as warehouse picking. See docs/milestones/
  // ROADMAP.md's "Things to never conflate" section.
  PICKING
  // Milestone 3A. Set once picking is both COMPLETED and AUTHORIZED (see
  // PickingSessionStatus below) -- the gate lib/handover/generate-handover.ts
  // (Milestone 3C) checks before it will produce an SAP Invoice Handover.
  READY_TO_INVOICE
  REJECTED
  CANCELLED
}

enum VerificationStatus {
  NOT_STARTED
  IN_PROGRESS
  VERIFIED
  FLAGGED
}

enum PriceDecisionStatus {
  PENDING
  APPROVED
  REJECTED
  NEEDS_REVIEW
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

// Milestone 3A. A PickingSession's own lifecycle -- deliberately separate
// from OrderStatus (which only tracks PICKING at the order level) so a
// session mid-flight has fine-grained state independent of whatever else
// might be true of the order.
//
// IN_PROGRESS  -- created by lib/picking/start-picking.ts; lines can still
//                 be recorded/edited (lib/picking/record-picked-line.ts).
// COMPLETED    -- every line has a found/unavailable split that accounts
//                 for its full requestedQuantity (lib/picking/
//                 complete-picking.ts); lines are now locked. Per the
//                 user's confirmed design (two steps, same roles: any
//                 authenticated user can pick and complete), this alone
//                 does NOT yet make the order invoice-ready.
// AUTHORIZED   -- a SALES_MANAGER or ADMINISTRATOR has signed off
//                 (lib/picking/authorize-picking.ts), which is what moves
//                 the order to OrderStatus.READY_TO_INVOICE and is the one
//                 state generateHandover (Milestone 3C) will accept.
enum PickingSessionStatus {
  IN_PROGRESS
  COMPLETED
  AUTHORIZED
}

enum DocumentType {
  CUSTOMER_PO
  SUPPORTING_DOCUMENT
  OTHER
}

// Milestone 2A. What kind of document this actually turned out to be,
// decided after upload (deterministically for EXCEL/CSV/MANUAL, by the
// extraction provider for PDF/IMAGE -- see lib/po-classification.ts).
// UNRELATED is the explicit "don't treat this as an order" outcome the
// Milestone 2 brief requires; it is a real, expected value, not an error
// state.
enum DocumentClassification {
  CUSTOMER_PO
  HANDWRITTEN_LIST
  CHAT_SCREENSHOT
  ORDER_SHEET
  PRICE_LIST
  DELIVERY_NOTE
  UNRELATED
}

// Milestone 2A. Lifecycle of one uploaded/pasted PO document, independent
// of whatever CustomerOrder it may or may not become later (that linkage
// is Milestone 2B's job -- see OrderDocument.orderId, already nullable).
// CONFIRMED (Milestone 2B) is the terminal state set by
// lib/review/confirm-review.ts in the same transaction that sets orderId
// -- a document sitting at EXTRACTED with orderId already non-null should
// never happen, but CONFIRMED gives the UI/queries a direct status check
// instead of having to infer "already turned into an order" from orderId
// being non-null.
enum DocumentIntakeStatus {
  RECEIVED
  CLASSIFIED
  EXTRACTING
  EXTRACTED
  EXTRACTION_FAILED
  CONFIRMED
}

// Milestone 2A. DETERMINISTIC covers the Excel/CSV parsers (lib/extraction/deterministic) --
// no AI call, included here (rather than left unlabelled) so every
// ExtractionRun row, regardless of path, is auditable the same way: "what
// produced this header/line data and how."
enum ExtractionProvider {
  ANTHROPIC
  MOCK
  DETERMINISTIC
}

enum ExtractionRunStatus {
  RUNNING
  SUCCEEDED
  FAILED
}

// Milestone 2B (matching, aliases, duplicate detection, human review).
// A human decision on one materialized extracted line -- distinct from
// VerificationStatus (OrderLine's post-order-creation SAP-catalogue
// verification) and from ExtractedLineMatchSource below (which describes
// HOW a candidate match was found, not whether a human has acted on it).
// PENDING is the only state a freshly-materialized line can be in; a line
// only ever becomes a real OrderLine (see ExtractedOrderLine.resultingOrderLineId)
// after the whole order is confirmed with this line at ACCEPTED.
enum ExtractedLineStatus {
  PENDING
  ACCEPTED
  EXCLUDED
}

// How ExtractedOrderLine.matchedProductId was arrived at. NONE: no
// candidate was found at all. ALIAS: an exact hit against ProductAlias
// (confidence 1.0, never re-scored). FUZZY: the matching engine's own
// token-overlap scoring picked a confident, unambiguous top candidate.
// MANUAL: a human picked (or overrode) the product in the review UI.
// Only FUZZY and MANUAL matches a human has explicitly accepted feed
// lib/matching/aliases.ts's alias-learning -- an ALIAS match that's simply
// re-confirmed strengthens the existing alias (recordProductAlias is
// idempotent either way) rather than creating a redundant one.
enum ExtractedLineMatchSource {
  NONE
  ALIAS
  FUZZY
  MANUAL
}

model User {
  id           String       @id @default(cuid())
  name         String
  email        String       @unique
  passwordHash String
  role         UserRole     @default(SALESPERSON)
  status       RecordStatus @default(ACTIVE)

  // Forces a password change on next login. Set true for the seeded admin
  // (whose initial password comes from an environment variable) and cleared
  // once the user sets their own password.
  mustChangePassword Boolean @default(false)

  // True only for rows created by prisma/seed.ts for demo/testing purposes.
  // Never true for a real account such as the seeded admin.
  isDemo Boolean @default(false)

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  createdOrders     CustomerOrder[]       @relation("OrderCreator")
  uploadedDocuments OrderDocument[]       @relation("DocumentUploader")
  verifications     ProductVerification[] @relation("VerificationUser")
  priceDecisions    PriceDecision[]       @relation("PriceDecisionUser")
  approvals         OrderApproval[]       @relation("ApprovalUser")
  statusChanges     OrderStatusHistory[]  @relation("StatusChangeUser")
  auditEvents       AuditEvent[]          @relation("AuditActor")
  sessions          Session[]

  // Milestone 2B.
  reviewedExtractedLines ExtractedOrderLine[] @relation("ExtractedLineReviewer")
  createdProductAliases  ProductAlias[]       @relation("ProductAliasCreator")
  createdCustomerAliases CustomerAlias[]      @relation("CustomerAliasCreator")
  generatedHandovers     OrderHandover[]      @relation("HandoverGenerator")

  // Milestone 3A. Picking has no dedicated role (per the user's confirmed
  // design): any authenticated user can start/complete a picking session;
  // only SALES_MANAGER/ADMINISTRATOR can authorize one (enforced in the
  // API route, not the schema -- see app/api/orders/[id]/picking/*).
  startedPickingSessions    PickingSession[] @relation("PickingSessionStarter")
  completedPickingSessions  PickingSession[] @relation("PickingSessionCompleter")
  authorizedPickingSessions PickingSession[] @relation("PickingSessionAuthorizer")
  pickedLines               PickingLine[]    @relation("PickingLinePicker")

  // Milestone 4 (Lost-Sales Management). Same "no dedicated role"
  // convention as picking: any authenticated user can record a customer
  // decision; only SALES_MANAGER/ADMINISTRATOR can confirm a lost sale
  // (enforced at the API route -- see app/api/lost-sales/*).
  recordedDecisionEvents CustomerDecisionEvent[] @relation("DecisionRecorder")
  confirmedLostSales     LostSaleRecord[]        @relation("LostSaleConfirmer")

  // Milestone 5 (SAP Invoice Reconciliation). Importing an SAP invoice
  // export has no dedicated role (same convention as Milestone 1's other
  // master-data imports -- any authenticated user can import); manually
  // matching/rejecting a line is restricted to SALES_MANAGER/
  // ADMINISTRATOR, since it overrides the matcher's own conservative
  // "do not silently guess" safety net -- enforced at the API route, see
  // app/api/invoice-reconciliation/*.
  uploadedInvoiceImportBatches SapInvoiceImportBatch[] @relation("InvoiceImportUploader")
  matchedInvoiceLines          SapInvoiceLine[]        @relation("InvoiceLineMatcher")

  // Milestone 6A (Invoice Claims Management). Same "no dedicated role"
  // convention: any authenticated user can create a claim, record
  // investigation findings/outcomes, or propose a resolution; only
  // SALES_MANAGER/ADMINISTRATOR can approve or reject a resolution, or
  // move a claim across an approval-weight status transition --
  // enforced at the API route, see app/api/invoice-claims/*.
  reportedClaims           InvoiceClaim[]           @relation("ClaimReporter")
  assignedClaims           InvoiceClaim[]           @relation("ClaimAssignee")
  recordedClaimResolutions ClaimResolution[]        @relation("ClaimResolutionRecorder")
  approvedClaimResolutions ClaimResolution[]        @relation("ClaimResolutionApprover")
  rejectedClaimResolutions ClaimResolution[]        @relation("ClaimResolutionRejecter")
  uploadedClaimAttachments InvoiceClaimAttachment[]  @relation("ClaimAttachmentUploader")

  // Milestone 6B (Returns & Credit Notes). Recording a credit note is
  // SALES_MANAGER/ADMINISTRATOR only (confirmed design decision -- it
  // asserts a completed financial fact, the same approval-weight tier as
  // approving a ClaimResolution); recording a physical return has no
  // dedicated role, same "no dedicated role" convention as every other
  // investigation/recording-weight action in this project -- enforced at
  // the API route, see app/api/invoice-claims/*/returns and
  // app/api/returns-credits/*.
  uploadedCreditNoteImportBatches CreditNoteImportBatch[] @relation("CreditNoteImportUploader")
  recordedCreditNotes             CreditNote[]            @relation("CreditNoteRecorder")
  matchedCreditNotes              CreditNote[]            @relation("CreditNoteMatcher")
  receivedClaimReturns            ClaimReturn[]           @relation("ClaimReturnReceiver")

  // Milestone 7 (Quotations Management). No dedicated role for any of
  // these (confirmed by the existing architecture: order creation itself
  // -- app/api/orders/route.ts -- has no role gate, and M7 introduces no
  // new financial-fact-creation action; approval-weight pricing/discount
  // gating is explicitly deferred to Milestone 8). Every action below is
  // open to any authenticated user, enforced only by requireUser() at
  // the route layer -- see app/api/quotations/*.
  preparedQuotations    Quotation[]      @relation("QuotationPreparer")
  assignedQuotations    Quotation[]      @relation("QuotationSalesperson")
  issuedQuotations      Quotation[]      @relation("QuotationIssuer")
  recordedQuotationResponses Quotation[] @relation("QuotationResponseRecorder")
  cancelledQuotations   Quotation[]      @relation("QuotationCanceller")
  supersededQuotations  Quotation[]      @relation("QuotationSuperseder")
  convertedQuotations   Quotation[]      @relation("QuotationConverter")
  quotationEvents       QuotationEvent[] @relation("QuotationEventActor")

  // Milestone 8 (Validation and Approvals). No dedicated "requester" role
  // (anyone whose action triggers a policy becomes a requester); approve/
  // reject/cancel are restricted to the request's own requiredApproverRole
  // at submission time (enforced in lib/approvals/requests.ts and the API
  // route, not the schema); withdraw is requester-only. See that module's
  // own comments for the self-approval and preparer-vs-approver blocks.
  approvalRequestsMade    ApprovalRequest[] @relation("ApprovalRequester")
  approvalDecisions       ApprovalRequest[] @relation("ApprovalDecider")
  approvalWithdrawals     ApprovalRequest[] @relation("ApprovalWithdrawer")
  approvalCancellations   ApprovalRequest[] @relation("ApprovalCanceller")
  approvalPoliciesCreated ApprovalPolicy[]  @relation("ApprovalPolicyCreator")
  approvalEvents          ApprovalEvent[]   @relation("ApprovalEventActor")
  notifications           Notification[]    @relation("NotificationRecipient")

  // Milestone 9 (SAP Business One Integration). ADMINISTRATOR-only
  // actions (connection configuration, manual full syncs) -- enforced at
  // the API route via requireUserOrResponse(["ADMINISTRATOR"]), not here.
  // A scheduled job has no User at all (triggeredById stays null; see
  // IntegrationSyncJob.trigger).
  integrationConnectionsUpdated IntegrationConnection[] @relation("IntegrationConnectionUpdater")
  integrationSyncJobsTriggered  IntegrationSyncJob[]    @relation("IntegrationSyncJobTrigger")

  // Milestone 10 (Communication Channels & Fulfilment). No dedicated role
  // for inbox review/convert/ignore, dispatch creation/departure, or
  // delivery recording (same "no dedicated role" convention as picking
  // and lost-sales recording above -- any authenticated user can do
  // these; enforced at the API route, not here). Resending a FAILED
  // OutboundMessage and cancelling a DispatchRecord ARE restricted to
  // SALES_MANAGER/ADMINISTRATOR -- see app/api/communications/* and
  // app/api/dispatches/*.
  reviewedMessageIntakes     MessageIntake[]   @relation("MessageIntakeReviewer")
  outboundMessagesTriggered  OutboundMessage[] @relation("OutboundMessageTrigger")
  outboundMessagesResent     OutboundMessage[] @relation("OutboundMessageResender")
  createdDispatchRecords     DispatchRecord[]  @relation("DispatchRecordCreator")
  departedDispatchRecords    DispatchRecord[]  @relation("DispatchRecordDeparter")
  cancelledDispatchRecords   DispatchRecord[]  @relation("DispatchRecordCanceller")
  recordedDeliveryRecords    DeliveryRecord[]  @relation("DeliveryRecordRecorder")

  @@index([isDemo])
}

model Session {
  id String @id @default(cuid())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // The cookie carries a jose-signed JWT whose only claim is this session's
  // id; the signature (keyed by AUTH_SECRET) is what makes the cookie
  // unforgeable, so no token/secret is stored here. This row exists purely
  // so a session can be looked up, checked for revocation/expiry against
  // fresh data, and revoked server-side (logout, forced password change,
  // admin action) even though the signed cookie itself keeps working until
  // its JWT `exp`.
  createdAt DateTime  @default(now()) @db.Timestamptz(6)
  expiresAt DateTime  @db.Timestamptz(6)
  revokedAt DateTime? @db.Timestamptz(6)

  userAgent String?
  ipAddress String?

  @@index([userId])
  @@index([expiresAt])
}

model Customer {
  id              String       @id @default(cuid())
  name            String
  sapCustomerCode String?      @unique
  email           String?
  phone           String?
  category        String?
  status          RecordStatus @default(ACTIVE)
  notes           String?

  // Milestone 1 (Master data from SAP). Confirmed real, from invoice
  // HRE580108: TIN and VAT REG are two separate numbers on a Willsgrove
  // SAP invoice, not one field. storeCode is kept distinct from
  // sapCustomerCode even though the one confirmed example (HREC0D677 = TM
  // Chinhoyi North) has them read the same on paper -- "is one SAP
  // customer code always exactly one store, or can one customer code have
  // several store/branch codes under it" is still an open assumption (see
  // docs/sap-exports/customer-master.csv.md), and collapsing the two
  // fields now would make that impossible to represent if the answer
  // turns out to be the latter for some chain.
  tin               String?
  vatNumber         String?
  currencyCode      String? // "USD" | "ZWG"
  paymentTermsCode  String?
  branchCode        String?
  storeCode         String?
  creditLimit       Decimal? @db.Decimal(18, 2)
  creditHold        Boolean  @default(false)

  priceListId String?
  priceList   PriceList? @relation(fields: [priceListId], references: [id], onDelete: SetNull)

  isDemo Boolean @default(false)

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  locations CustomerLocation[]
  contacts  CustomerContact[]
  orders    CustomerOrder[]

  // Milestone 2B.
  productAliases  ProductAlias[]
  customerAliases CustomerAlias[]

  // Milestone 4 (Lost-Sales Management).
  unfulfilledDemands UnfulfilledDemand[]

  // Milestone 5 (SAP Invoice Reconciliation).
  sapInvoices SapInvoice[]

  // Milestone 6A (Invoice Claims Management).
  invoiceClaims InvoiceClaim[]

  // Milestone 7 (Quotations Management).
  quotations Quotation[]

  // Milestone 10 (Communication Channels & Fulfilment).
  messageIntakes    MessageIntake[]
  outboundMessages  OutboundMessage[]

  @@index([name])
  @@index([status])
  @@index([isDemo])
  @@index([priceListId])
  @@index([storeCode])
}

// Milestone 1 (Master data from SAP). A real business partner in SAP B1
// can have several named contacts; this is one-to-many for that reason,
// even though the customer-master CSV layout (one row per customer) can
// only seed a single primary contact per import -- see
// docs/sap-exports/customer-master.csv.md. Further contacts would be
// added by hand later; no UI for that is built in this milestone.
model CustomerContact {
  id         String  @id @default(cuid())
  customerId String
  name       String
  role       String?
  email      String?
  phone      String?

  isDemo Boolean @default(false)

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Restrict)

  // Milestone 7 (Quotations Management). "Customer contact, where
  // available" -- a quotation may name which of the customer's contacts
  // it was prepared for/sent to.
  quotations Quotation[]

  // Milestone 10 (Communication Channels & Fulfilment).
  messageIntakes   MessageIntake[]
  outboundMessages OutboundMessage[]

  @@index([customerId])
  @@index([isDemo])
}

model CustomerLocation {
  id           String  @id @default(cuid())
  customerId   String
  label        String
  addressLine1 String
  addressLine2 String?
  city         String?
  province     String?
  isDefault    Boolean @default(false)
  isActive     Boolean @default(true)

  isDemo Boolean @default(false)

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  customer Customer        @relation(fields: [customerId], references: [id], onDelete: Restrict)
  orders   CustomerOrder[]

  @@index([customerId])
  @@index([isDemo])
}

model Product {
  id          String       @id @default(cuid())
  sapItemCode String       @unique
  itemName    String
  barcode     String?
  category    String?
  status      RecordStatus @default(ACTIVE)

  // Milestone 1 (Master data from SAP): the real SAP item export
  // (CODE/ITEM DESCRIPTION/BARCODE/ITEM GROUP -- confirmed against the
  // business's actual 7,540-row export) has none of these as columns, so
  // they are never derived from itemName -- that would mean guessing at
  // 7,540 inconsistently-formatted descriptions. They are populated only
  // by the separate item-master-extension import
  // (lib/item-master-import.ts), one SAP field each, left null until that
  // file is imported for a given item.
  unitOfMeasure    String? // SAP unit-of-measure code, e.g. "PNT", "KG"
  packSize         String? // e.g. "250G" -- free text, as SAP itself holds it
  isVariableWeight Boolean @default(false)

  // SAP tax code (e.g. "VAT00", "VAT15"), not a relation to TaxCode.code:
  // the item-master-extension import and the tax-code import are separate
  // SAP exports that can land in either order, and a plain string (same
  // pattern as sapItemCode/sapCustomerCode elsewhere in this schema) means
  // neither import blocks on the other. The item-master importer still
  // validates this against known TaxCode rows at import time and warns
  // (never hard-fails) when a code isn't recognized yet -- see
  // lib/item-master-import.ts.
  vatCode String?

  // Preserve the original SAP row for traceability.
  sourceData Json?
  importedAt DateTime?

  // True only for the small set of placeholder products prisma/seed.ts
  // creates to exercise demo orders. Real SAP items imported through
  // /products/import are never demo, regardless of how few are referenced
  // by seeded orders.
  isDemo Boolean @default(false)

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  orderLines       OrderLine[]
  stockLines       StockSnapshotLine[]
  priceListEntries PriceListEntry[]

  // Milestone 2B.
  aliases                 ProductAlias[]
  matchedByExtractedLines ExtractedOrderLine[]

  // Milestone 4 (Lost-Sales Management).
  unfulfilledDemands        UnfulfilledDemand[]
  substituteDecisionEvents  CustomerDecisionEvent[] @relation("SubstituteProductRef")

  // Milestone 7 (Quotations Management).
  quotationLines QuotationLine[]

  @@index([itemName])
  @@index([category])
  @@index([status])
  @@index([barcode])
  @@index([isDemo])
  @@index([vatCode])
}

// Milestone 1 (Master data from SAP). VAT varies per item -- confirmed
// explicitly, never a flat rate -- so the rate lives in a real lookup
// table, not a constant. ratePercent is current-only (not effective-dated)
// because it's unconfirmed whether the SAP export exposes VAT-rate
// history; see docs/sap-exports/tax-codes.csv.md "Assumptions to confirm."
model TaxCode {
  id          String  @id @default(cuid())
  code        String  @unique
  description String?
  ratePercent Decimal @db.Decimal(5, 2)

  isDemo Boolean @default(false)

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  @@index([isDemo])
}

// Milestone 1 (Master data from SAP). "Price lists per customer or group
// (validity dates, currency)" -- a named list, not a bare
// per-customer price column, because SAP B1 price lists are themselves
// named/coded objects that one or many customers can be assigned to. See
// docs/sap-exports/price-lists.csv.md.
model PriceList {
  id           String @id @default(cuid())
  code         String @unique
  name         String
  currencyCode String // "USD" | "ZWG"

  isDemo Boolean @default(false)

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  entries   PriceListEntry[]
  customers Customer[]

  @@index([isDemo])
}

// One row per item per list, with validity dates: prices change over
// time, and an order needs "the price in effect on this order's date,"
// not just "the current price" -- so this is a history, not a snapshot.
// sapItemCodeSnapshot (same pattern as OrderLine.sapItemCodeSnapshot)
// keeps the SAP code even if productId is later nulled by a Product
// deletion.
model PriceListEntry {
  id                  String    @id @default(cuid())
  priceListId         String
  productId           String?
  sapItemCodeSnapshot String
  unitPrice           Decimal   @db.Decimal(18, 4)
  validFrom           DateTime  @db.Timestamptz(6)
  validTo             DateTime? @db.Timestamptz(6)

  isDemo Boolean @default(false)

  createdAt DateTime @default(now()) @db.Timestamptz(6)

  priceList PriceList @relation(fields: [priceListId], references: [id], onDelete: Restrict)
  product   Product?  @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@index([priceListId, sapItemCodeSnapshot])
  @@index([validFrom, validTo])
  @@index([isDemo])
}

model CustomerOrder {
  id                 String  @id @default(cuid())
  reference          String  @unique
  customerId         String
  customerLocationId String?
  createdById        String

  customerPoReference String?
  source              OrderSource
  status              OrderStatus @default(DRAFT)

  orderDate             DateTime? @db.Date
  requestedDeliveryDate DateTime? @db.Date

  deliveryAddress String?
  currency        String  @default("USD")

  subtotal Decimal? @db.Decimal(18, 4)
  taxTotal Decimal? @db.Decimal(18, 4)
  total    Decimal? @db.Decimal(18, 4)

  // The customer's own message/PO text, preserved verbatim, when the order
  // was submitted by pasting it in rather than (or alongside) an uploaded
  // document or manually-keyed lines -- the same "preserve the customer's
  // own words" principle OrderLine.originalProductDescription already
  // follows. Distinct from internalNotes, which is staff-only commentary,
  // never the customer's own text. Null when the order was created purely
  // from manual entry and/or an uploaded file with nothing pasted in.
  originalSourceText String?

  internalNotes String?

  // Lets a client safely retry a create-order submission (e.g. after a
  // dropped response) without risking a duplicate order. Enforced by a
  // unique constraint; lib/orders.ts returns the original order on a repeat.
  idempotencyKey String? @unique

  // Baseline timing capture (Milestone 0 acceptance). Nullable because an
  // order may be mid-flow; set by lib/orders.ts as each stage happens, not
  // backfilled or guessed. Feeds throughput/funnel reporting from
  // Milestone 8 onward without re-deriving every read from
  // OrderStatusHistory joins.
  receivedAt     DateTime? @db.Timestamptz(6)
  extractedAt    DateTime? @db.Timestamptz(6)
  reviewedAt     DateTime? @db.Timestamptz(6)
  approvedAt     DateTime? @db.Timestamptz(6)
  handedToSapAt  DateTime? @db.Timestamptz(6)
  invoicedAt     DateTime? @db.Timestamptz(6)

  isDemo Boolean @default(false)

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  customer         Customer          @relation(fields: [customerId], references: [id], onDelete: Restrict)
  customerLocation CustomerLocation? @relation(fields: [customerLocationId], references: [id], onDelete: SetNull)
  createdBy        User              @relation("OrderCreator", fields: [createdById], references: [id], onDelete: Restrict)

  lines          OrderLine[]
  documents      OrderDocument[]
  approvals      OrderApproval[]
  statusHistory  OrderStatusHistory[]
  handovers      OrderHandover[]
  pickingSessions PickingSession[]

  // Milestone 4 (Lost-Sales Management).
  unfulfilledDemands UnfulfilledDemand[]

  // Milestone 5 (SAP Invoice Reconciliation). An order's own
  // matchedSapInvoices is header-level convenience only (set when every
  // line of that invoice agreed on this one order) -- matchedSapInvoiceLines
  // is the authoritative, line-level link; one order can span several SAP
  // invoices and vice versa (spec section 4).
  matchedSapInvoices     SapInvoice[]
  matchedSapInvoiceLines SapInvoiceLine[]

  // Milestone 6A (Invoice Claims Management). Nullable on InvoiceClaim
  // itself ("where possible, the original SalesFlow order") -- see that
  // model's own comment.
  invoiceClaims InvoiceClaim[]

  // Milestone 7 (Quotations Management). Pure Prisma inverse side of
  // Quotation.convertedOrderId (a unique scalar FK living on Quotation,
  // not here) -- at most ONE Quotation can ever point to a given order,
  // which is what structurally prevents "accepting a quotation twice"
  // from ever producing two orders for it (spec section 8's "avoid
  // duplicate orders"). Null for the (large majority of) orders never
  // created from a quotation.
  sourceQuotation Quotation? @relation("QuotationConvertedOrder")

  // Milestone 8 (Validation and Approvals). Schema/policy-ready
  // (ApprovalModule.ORDERS / ApprovalActionType.ORDER_VALUE_EXCEEDS_
  // THRESHOLD exist and can be configured), but NOT YET populated by any
  // live trigger in lib/orders.ts -- a deliberate scope decision this
  // round, see docs/milestones/PROGRESS.md's Milestone 8 "known
  // limitations." Always empty today; kept as a real typed relation
  // (not a later migration) so wiring the live gate later is additive
  // code only, no schema change.
  approvalRequests ApprovalRequest[] @relation("OrderApprovalRequests")

  // Milestone 9 (SAP Business One Integration). Pure Prisma inverse side
  // of IntegrationOperation.customerOrderId (a unique scalar FK living on
  // IntegrationOperation, not here) -- at most one outbox row can ever
  // exist for a given order, which is the DB-level duplicate-submission
  // guard spec section 7.2 requires. Null until this order is actually
  // submitted (or attempted) for SAP sales-order creation; most orders
  // never reach that point in this milestone, since eligibility requires
  // an approved commercial price source that only quotation-converted
  // orders currently have -- see lib/integrations/sap/order-eligibility.ts
  // and docs/milestones/PROGRESS.md's Milestone 9 section.
  integrationOperation IntegrationOperation?

  // Milestone 10 (Communication Channels & Fulfilment). linkedMessageIntakes
  // is the pure Prisma inverse side of MessageIntake.linkedOrderId (a
  // follow-up email/WhatsApp message a reviewer tied to this already-
  // existing order, e.g. "where is my delivery" -- never a new PO).
  // outboundMessages is the inverse of OutboundMessage.relatedOrderId.
  // dispatchRecords is this order's own dispatch/delivery fulfilment
  // history -- deliberately NOT a change to OrderStatus itself (see
  // DispatchStatus's own comment for why dispatch/delivery gets its own
  // separate lifecycle, the same precedent PickingSessionStatus and
  // IntegrationOperationStatus already set).
  linkedMessageIntakes MessageIntake[]
  outboundMessages     OutboundMessage[]
  dispatchRecords      DispatchRecord[]

  @@index([customerId])
  @@index([status])
  @@index([orderDate])
  @@index([createdAt])
  @@index([isDemo])
}

model OrderLine {
  id         String @id @default(cuid())
  orderId    String
  lineNumber Int

  // Preserve the wording on the customer's original PO.
  originalProductDescription String

  productId           String?
  sapItemCodeSnapshot String?

  requestedQuantity Decimal @db.Decimal(18, 4)
  requestedUnitCode String

  customerUnitPrice Decimal? @db.Decimal(18, 4)
  approvedUnitPrice Decimal? @db.Decimal(18, 4)
  lineTotal         Decimal? @db.Decimal(18, 4)

  verificationStatus VerificationStatus @default(NOT_STARTED)

  salesNotes String?

  isDemo Boolean @default(false)

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  order          CustomerOrder         @relation(fields: [orderId], references: [id], onDelete: Restrict)
  product        Product?              @relation(fields: [productId], references: [id], onDelete: SetNull)
  verifications  ProductVerification[]
  priceDecisions PriceDecision[]
  pickingLines   PickingLine[]

  // Milestone 4 (Lost-Sales Management). One per OrderLine whose picking
  // ultimately left some quantity unavailable -- see UnfulfilledDemand's
  // own comment for why this is keyed off PickingLine, not directly off
  // this relation's cardinality.
  unfulfilledDemands UnfulfilledDemand[]

  // Milestone 5 (SAP Invoice Reconciliation). The matched SAP invoice
  // line(s) actually invoicing this order line -- zero, one, or (a
  // partial shipment invoiced across more than one SAP document) several.
  matchedSapInvoiceLines SapInvoiceLine[]

  // Milestone 2B. Set once this line is created FROM a reviewed/confirmed
  // ExtractedOrderLine (see lib/review/confirm-review.ts) -- null for any
  // line created the old way, through manual order entry with no PO
  // document behind it at all. The FK itself lives on ExtractedOrderLine
  // (resultingOrderLineId); this is purely the Prisma-required inverse
  // side, with no column of its own on this table.
  extractedOrderLine ExtractedOrderLine?

  // Milestone 10 (Communication Channels & Fulfilment). Zero or more
  // DispatchLine rows across however many separate dispatches this line
  // ends up needing (partial fulfilment) -- see DispatchLine's own
  // comment for how outstanding quantity is derived.
  dispatchLines DispatchLine[]

  @@unique([orderId, lineNumber])
  @@index([productId])
  @@index([verificationStatus])
  @@index([isDemo])
}

model OrderDocument {
  id           String  @id @default(cuid())
  orderId      String?
  uploadedById String

  documentType     DocumentType @default(CUSTOMER_PO)
  originalFileName String
  storageKey       String       @unique
  mimeType         String
  fileSize         BigInt
  checksum         String?

  extractedText String?

  // Milestone 2A additions. orderId stays nullable exactly as it already
  // was (Milestone 0) -- a PO document now routinely exists for a while
  // with no CustomerOrder at all, from upload through extraction, until
  // Milestone 2B's matching step creates or identifies one. Nothing here
  // changes the meaning of any pre-existing row: all four columns below
  // are nullable/defaulted, so every Milestone 0/2 document (orderId
  // already set, no sourceChannel) reads back exactly as before.
  sourceChannel  OrderSource?
  classification DocumentClassification?
  status         DocumentIntakeStatus    @default(RECEIVED)

  // Groups multiple photos/pages that belong to one PO submission (e.g.
  // three camera photos of a long handwritten list). Null for a
  // single-file upload or a pasted-text submission. pageNumber orders
  // the rows within a group; both are plain fields rather than a separate
  // join table because a group is only ever "these N OrderDocument rows,
  // in this order" -- nothing else hangs off the group itself at this
  // milestone.
  documentGroupId String?
  pageNumber      Int?

  createdAt DateTime @default(now()) @db.Timestamptz(6)

  order         CustomerOrder?  @relation(fields: [orderId], references: [id], onDelete: Restrict)
  uploadedBy    User            @relation("DocumentUploader", fields: [uploadedById], references: [id], onDelete: Restrict)
  extractionRuns ExtractionRun[]

  // Milestone 10 (Communication Channels & Fulfilment). Pure Prisma
  // inverse side of MessageIntake.resultingOrderDocumentId (a unique
  // scalar FK living on MessageIntake, not here) -- set only when this
  // document was created by a reviewer converting an email/WhatsApp
  // MessageIntake via lib/po-intake.ts's existing createPoIntake(). Null
  // for every document created the pre-existing way (direct upload,
  // paste from the order-creation form with no channel intake behind
  // it).
  sourceMessageIntake MessageIntake?

  @@index([orderId])
  @@index([documentGroupId])
  @@index([status])
}

// Milestone 2A. One row per extraction attempt against an OrderDocument --
// append-only (a re-extract creates a NEW row rather than overwriting the
// last one) so the original extraction output is always preserved per the
// Milestone 2 brief's audit requirement, even after a later re-run.
//
// extractedHeader/extractedLines are Json, not their own relational
// tables, deliberately for 2A: nothing yet edits an individual line,
// matches it to a product, or tracks per-line review state -- that is
// Milestone 2B's job, where each line becomes a real ExtractedOrderLine-
// style row with its own id, matchedProductId, and reviewStatus. Modelling
// that structure now, before 2B's matching engine exists to populate it,
// would be guessing at shape rather than building against a real need.
// Both are validated on the way in against the versioned schema in
// lib/extraction/schema.ts (promptVersion identifies which version a given
// row was produced against).
model ExtractionRun {
  id         String @id @default(cuid())
  documentId String

  provider      ExtractionProvider
  model         String?
  promptVersion String

  startedAt   DateTime  @default(now()) @db.Timestamptz(6)
  completedAt DateTime? @db.Timestamptz(6)
  status      ExtractionRunStatus @default(RUNNING)

  extractedHeader Json?
  extractedLines  Json?
  rawResponse     Json?
  errorMessage    String?
  processingTimeMs Int?

  isDemo Boolean @default(false)

  createdAt DateTime @default(now()) @db.Timestamptz(6)

  document OrderDocument @relation(fields: [documentId], references: [id], onDelete: Restrict)

  // Milestone 2B.
  extractedOrderLines ExtractedOrderLine[]

  @@index([documentId])
  @@index([status])
  @@index([isDemo])
}

// Milestone 2B. One row per line of the latest SUCCEEDED ExtractionRun,
// materialized by lib/review/build-review-session.ts the first time a
// human opens that document's review workspace -- idempotent, so opening
// the workspace twice never creates duplicate rows (enforced by the
// unique constraint below, not just by application logic). This is the
// "real ExtractedOrderLine-style row with its own id, matchedProductId,
// and reviewStatus" that Milestone 2A's own ExtractionRun comment already
// signposted as 2B's job, rather than retrofitting that structure onto
// ExtractionRun.extractedLines' Json after the fact.
//
// Nothing here is a real OrderLine yet, and nothing here is visible to
// SAP or the eventual Excel handover (Milestone 2C) -- this table is
// purely the working area a human reviews and confirms, or rejects,
// before (if ever) a line becomes real. See resultingOrderLineId.
model ExtractedOrderLine {
  id              String @id @default(cuid())
  extractionRunId String
  lineNumber      Int

  // Copied from ExtractionRun.extractedLines at materialization time
  // (not re-read from Json on every access) so this table is a complete,
  // query-able, independently-indexable snapshot of each line -- same
  // decimal-as-string-at-the-edge/Decimal-at-rest pattern as everywhere
  // else in this schema; quantities/prices are never a float.
  originalDescription       String
  extractedQuantity         Decimal? @db.Decimal(18, 4)
  extractedUnit             String?
  // Traceability only -- same rule as OrderLine.customerUnitPrice and
  // ExtractionRun's own line shape: never read for a pricing decision.
  customerProvidedUnitPrice Decimal? @db.Decimal(18, 4)
  extractionConfidence      Float?
  // Array of short warning strings from the extraction step itself (e.g.
  // "no quantity stated") -- carried over so the review UI can show them
  // without re-reading the parent ExtractionRun's Json.
  extractionWarnings        Json?

  // The matching engine's suggestion (lib/matching/product-matcher.ts),
  // or a human's explicit choice/override in the review UI -- either way
  // this is a SUGGESTION until status is ACCEPTED; nothing reads this as
  // a confirmed fact before then.
  matchedProductId String?
  matchConfidence   Float?
  matchSource       ExtractedLineMatchSource @default(NONE)
  // Up to a handful of {productId, sapItemCode, itemName, score} runner-up
  // candidates, for the review UI's "did you mean" list when the top
  // match isn't confident/unambiguous enough to pre-select on its own.
  matchCandidates   Json?

  status       ExtractedLineStatus @default(PENDING)
  reviewedById String?
  reviewedAt   DateTime? @db.Timestamptz(6)
  reviewNotes  String?

  // Set by lib/review/confirm-review.ts once (and only once) this line is
  // actually turned into a real OrderLine as part of confirming the whole
  // order -- never set for an EXCLUDED line. Unique because one extracted
  // line can only ever become one order line.
  resultingOrderLineId String? @unique

  isDemo Boolean @default(false)

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  extractionRun      ExtractionRun       @relation(fields: [extractionRunId], references: [id], onDelete: Restrict)
  matchedProduct     Product?            @relation(fields: [matchedProductId], references: [id], onDelete: SetNull)
  reviewedBy         User?               @relation("ExtractedLineReviewer", fields: [reviewedById], references: [id], onDelete: Restrict)
  resultingOrderLine OrderLine?          @relation(fields: [resultingOrderLineId], references: [id], onDelete: SetNull)

  @@unique([extractionRunId, lineNumber])
  @@index([extractionRunId])
  @@index([matchedProductId])
  @@index([status])
  @@index([isDemo])
}

// Milestone 2B. A persistent mapping from a customer's own free-text
// product wording (as normalized -- see lib/matching/normalize.ts) to a
// resolved SAP Product, learned from human-confirmed matches during order
// review (lib/review/confirm-review.ts calls lib/matching/aliases.ts's
// recordProductAlias for every FUZZY/MANUAL match a human accepts).
// customerId null = a global alias (any customer); set = scoped to that
// one customer, since the same phrase can mean a different product to a
// different customer. A customer-specific alias always takes precedence
// over a global one with the same normalizedText when matching
// (lib/matching/aliases.ts's lookup order).
//
// Uniqueness: the @@index below is for query planning/documentation only.
// The actual uniqueness -- one global alias per normalizedText, and one
// per-customer alias per (customerId, normalizedText) -- is enforced by
// two PARTIAL unique indexes added directly in this table's migration's
// raw SQL (`CREATE UNIQUE INDEX ... WHERE "customerId" IS [NOT] NULL`),
// because Prisma's schema DSL cannot express a partial/conditional unique
// constraint. If this table is ever touched by a hand-written migration
// again, both partial indexes must be explicitly preserved -- a plain
// `prisma migrate dev` diff against this schema file alone would not know
// to recreate them.
model ProductAlias {
  id             String  @id @default(cuid())
  customerId     String?
  rawText        String
  normalizedText String

  productId String

  timesConfirmed  Int      @default(1)
  lastConfirmedAt DateTime @default(now()) @db.Timestamptz(6)

  createdById String
  isDemo      Boolean @default(false)

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  // Cascade (not SetNull) on both FKs deliberately: an alias with no
  // product is meaningless, and -- more importantly -- an alias whose
  // customerId was merely nulled out by SetNull would silently turn a
  // customer-specific mapping into a global one, which is a real
  // correctness bug, not a harmless orphan. Deleting the alias row
  // entirely is the only safe behavior either way.
  customer  Customer? @relation(fields: [customerId], references: [id], onDelete: Cascade)
  product   Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdBy User      @relation("ProductAliasCreator", fields: [createdById], references: [id], onDelete: Restrict)

  @@index([customerId, normalizedText])
  @@index([normalizedText])
  @@index([productId])
  @@index([isDemo])
}

// Milestone 2B. Same learning mechanism as ProductAlias, for the order
// header's customer/store identification instead of a line's product.
// Always global -- there is no further scope below "customer" to narrow
// a customer-name alias by -- so a single plain unique index on
// normalizedText is sufficient here, unlike ProductAlias's two partial
// indexes.
model CustomerAlias {
  id             String @id @default(cuid())
  rawText        String
  normalizedText String @unique

  customerId String

  timesConfirmed  Int      @default(1)
  lastConfirmedAt DateTime @default(now()) @db.Timestamptz(6)

  createdById String
  isDemo      Boolean @default(false)

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  customer  Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  createdBy User     @relation("CustomerAliasCreator", fields: [createdById], references: [id], onDelete: Restrict)

  @@index([customerId])
  @@index([isDemo])
}

model ProductVerification {
  id           String @id @default(cuid())
  orderLineId  String
  verifiedById String

  productMatched  Boolean @default(false)
  quantityChecked Boolean @default(false)
  unitMatched     Boolean @default(false)

  status VerificationStatus
  notes  String?

  createdAt DateTime @default(now()) @db.Timestamptz(6)

  orderLine  OrderLine @relation(fields: [orderLineId], references: [id], onDelete: Restrict)
  verifiedBy User      @relation("VerificationUser", fields: [verifiedById], references: [id], onDelete: Restrict)

  @@index([orderLineId])
}

model PriceDecision {
  id          String @id @default(cuid())
  orderLineId String
  decidedById String

  customerUnitPrice Decimal  @db.Decimal(18, 4)
  approvedUnitPrice Decimal? @db.Decimal(18, 4)

  status PriceDecisionStatus
  notes  String?

  createdAt DateTime @default(now()) @db.Timestamptz(6)

  orderLine OrderLine @relation(fields: [orderLineId], references: [id], onDelete: Restrict)
  decidedBy User      @relation("PriceDecisionUser", fields: [decidedById], references: [id], onDelete: Restrict)

  @@index([orderLineId])
}

model OrderApproval {
  id          String  @id @default(cuid())
  orderId     String
  decidedById String?

  status ApprovalStatus @default(PENDING)
  notes  String?

  decidedAt DateTime? @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @db.Timestamptz(6)

  order     CustomerOrder @relation(fields: [orderId], references: [id], onDelete: Restrict)
  decidedBy User?         @relation("ApprovalUser", fields: [decidedById], references: [id], onDelete: Restrict)

  @@index([orderId])
  @@index([status])
}

model StockSnapshot {
  id             String   @id @default(cuid())
  snapshotAt     DateTime @db.Timestamptz(6)
  sourceFileName String?
  importedAt     DateTime @default(now()) @db.Timestamptz(6)
  notes          String?

  lines StockSnapshotLine[]

  @@index([snapshotAt])
}

model StockSnapshotLine {
  id         String @id @default(cuid())
  snapshotId String
  productId  String

  warehouseCode String
  warehouseName String?
  quantity      Decimal @db.Decimal(18, 4)
  unitCode      String

  snapshot StockSnapshot @relation(fields: [snapshotId], references: [id], onDelete: Restrict)
  product  Product       @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@unique([snapshotId, productId, warehouseCode])
  @@index([productId])
}

model OrderStatusHistory {
  id          String  @id @default(cuid())
  orderId     String
  changedById String?

  fromStatus OrderStatus?
  toStatus   OrderStatus
  notes      String?

  createdAt DateTime @default(now()) @db.Timestamptz(6)

  order     CustomerOrder @relation(fields: [orderId], references: [id], onDelete: Restrict)
  changedBy User?         @relation("StatusChangeUser", fields: [changedById], references: [id], onDelete: Restrict)

  @@index([orderId])
}

model AuditEvent {
  id      String  @id @default(cuid())
  actorId String?

  action     String
  entityType String
  entityId   String

  beforeData Json?
  afterData  Json?

  createdAt DateTime @default(now()) @db.Timestamptz(6)

  actor User? @relation("AuditActor", fields: [actorId], references: [id], onDelete: Restrict)

  @@index([entityType, entityId])
  @@index([actorId])
  @@index([createdAt])
}

// Milestone 2C (handover, multi-store split, repeat orders). How a
// generated handover's content was delivered -- EXCEL and CSV are stored
// files (StorageDriver), CLIPBOARD is never stored as a file at all (see
// OrderHandover.storageKey below) since it's meant to be copied straight
// onto the clipboard for the invoice team to paste wherever they need it,
// not kept as a document. (Milestone 3C: this project makes no claim
// about where it's safe to paste -- see HandoverPanel's copy-success
// message -- only that the clipboard format itself is never persisted as
// a file.)
enum HandoverFormat {
  EXCEL
  CSV
  CLIPBOARD
}

// Milestone 3A (SAP Invoice Handover Specification -- warehouse picking).
// One row per picking attempt on an order. Unlike OrderHandover/
// ExtractionRun's pure append-only convention, a session's OWN row is
// mutated as picking progresses (IN_PROGRESS -> COMPLETED -> AUTHORIZED) --
// but once a session reaches AUTHORIZED it is never mutated again, and a
// correction after that point starts a brand-new session rather than
// reopening the old one, so the full history of every picking attempt
// (who, when, what was found/unavailable) is always preserved. See
// PickingSessionStatus's comment above for the state machine, and
// lib/picking/*.ts for the one function per transition.
//
// Deliberately one row per ORDER PER ATTEMPT, not one per OrderLine --
// PickingLine (below) holds the per-line detail. An order may have more
// than one PickingSession across its lifetime (a re-pick after a
// correction), but at most one that is IN_PROGRESS or COMPLETED-but-not-
// yet-authorized at any given time (enforced in
// lib/picking/start-picking.ts, not the schema, the same way other
// cross-row business rules in this project are enforced in lib/ rather
// than with a DB constraint that can't express "unless the latest one is
// AUTHORIZED").
model PickingSession {
  id      String               @id @default(cuid())
  orderId String
  status  PickingSessionStatus @default(IN_PROGRESS)

  startedById String
  startedAt   DateTime @default(now()) @db.Timestamptz(6)

  completedById String?
  completedAt   DateTime? @db.Timestamptz(6)

  authorizedById String?
  authorizedAt   DateTime? @db.Timestamptz(6)

  notes String?

  isDemo Boolean @default(false)

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  order       CustomerOrder @relation(fields: [orderId], references: [id], onDelete: Restrict)
  startedBy   User          @relation("PickingSessionStarter", fields: [startedById], references: [id], onDelete: Restrict)
  completedBy User?         @relation("PickingSessionCompleter", fields: [completedById], references: [id], onDelete: Restrict)
  authorizedBy User?        @relation("PickingSessionAuthorizer", fields: [authorizedById], references: [id], onDelete: Restrict)

  lines     PickingLine[]
  handovers OrderHandover[]

  // Milestone 4 (Lost-Sales Management).
  unfulfilledDemands UnfulfilledDemand[]

  // Milestone 10 (Communication Channels & Fulfilment). Optional link
  // from a dispatch to the specific AUTHORIZED session its quantities
  // were sourced from -- same optional-traceability pattern as
  // OrderHandover.pickingSessionId above.
  dispatchRecords DispatchRecord[]

  @@index([orderId])
  @@index([status])
  @@index([isDemo])
}

// Milestone 3A. One row per OrderLine being picked in a given session --
// created (one per order line, requestedQuantity snapshotted at that
// moment) the instant the session starts, then filled in as picking
// happens. requestedQuantity is a SNAPSHOT (not read live off OrderLine at
// handover time) so this row stays an honest record of what was being
// picked against even if OrderLine data could ever change later -- same
// "preserve what was actually true at the time" principle as
// OrderLine.sapItemCodeSnapshot.
//
// foundQuantity + unavailableQuantity must equal requestedQuantity before
// the owning session can be marked COMPLETED (enforced in
// lib/picking/complete-picking.ts) -- the spec's point 3 worked example
// (20 requested / 20 found / 0 unavailable; 15 / 10 / 5; 30 / 25 / 5).
// Both are nullable because a line can be saved mid-entry, before that
// full accounting is in.
model PickingLine {
  id               String @id @default(cuid())
  pickingSessionId String
  orderLineId      String

  requestedQuantity   Decimal  @db.Decimal(18, 4)
  foundQuantity       Decimal? @db.Decimal(18, 4)
  unavailableQuantity Decimal? @db.Decimal(18, 4)

  notes String?

  pickedById String?
  pickedAt   DateTime? @db.Timestamptz(6)

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  pickingSession PickingSession @relation(fields: [pickingSessionId], references: [id], onDelete: Cascade)
  orderLine      OrderLine      @relation(fields: [orderLineId], references: [id], onDelete: Restrict)
  pickedBy       User?          @relation("PickingLinePicker", fields: [pickedById], references: [id], onDelete: Restrict)

  // Milestone 4 (Lost-Sales Management). At most one -- enforced by
  // UnfulfilledDemand's own @@unique([pickingLineId]) -- created
  // automatically by lib/picking/authorize-picking.ts the moment this
  // line is authorized with unavailableQuantity > 0. A later re-pick
  // creates a brand-new PickingLine (Milestone 3A's existing
  // history-preserving design), so it gets its own separate
  // UnfulfilledDemand too; this line's own record and its full decision
  // history are never touched or reused.
  unfulfilledDemand UnfulfilledDemand?

  @@unique([pickingSessionId, orderLineId])
  @@index([orderLineId])
}

// Milestone 2C. One append-only row per handover generated for an order --
// never overwritten or deduplicated, the same "every attempt is its own
// row" convention ExtractionRun (Milestone 2A) already established, and
// for the same reason: if the invoice team regenerates a handover after a
// correction, the fact that an earlier one existed (and exactly what it
// said) stays on the record rather than being silently replaced.
//
// Deliberately does NOT duplicate the row content itself (SAP item
// code/description/quantity per line) into this table -- that's always
// rebuilt fresh from the order's current OrderLine/Product data by
// lib/handover/build-handover-rows.ts at generation time, so a handover
// always reflects the order as it actually is right now. This table only
// records that a handover happened, in what format, by whom, and (for a
// stored file) where to download it again.
//
// Milestone 3A/3C additions: `reference` is the spec's "Handover
// Reference" header field (nullable because handovers generated before
// this field existed have none -- never backfilled; generated fresh per
// handover by lib/handover/generate-handover.ts's generateHandoverReference(),
// same HND-YYYYMMDD-XXXXXXXX shape and collision-retry convention as
// lib/orders.ts's generateOrderReference() -- see that function). @unique
// is safe to add even with many existing NULL rows: Postgres never treats
// two NULLs as colliding under a unique index. `pickingSessionId` records
// exactly which AUTHORIZED PickingSession this handover's quantities were
// sourced from (lib/handover/generate-handover.ts, Milestone 3C), so the
// traceability chain (spec section 6) is never ambiguous even after a
// later re-pick.
model OrderHandover {
  id               String          @id @default(cuid())
  orderId          String
  pickingSessionId String?
  reference        String?         @unique
  format           HandoverFormat
  generatedById    String

  // Rebuilt and recorded at generation time, not inferred later, so this
  // row stays an honest record of what was actually generated even if
  // the order's lines are edited afterward.
  lineCount          Int
  matchedLineCount   Int // lines with a resolved SAP item code at generation time
  unmatchedLineCount Int // lines with NO resolved SAP item code -- never silently dropped, always flagged in the handover content itself too (see lib/handover/build-handover-rows.ts)

  // All four null for CLIPBOARD (nothing is ever stored as a file for
  // that format -- see the enum comment above); all four set for
  // EXCEL/CSV, same fields OrderDocument already uses for a stored file.
  storageKey       String?
  originalFileName String?
  mimeType         String?
  fileSize         BigInt?

  isDemo Boolean @default(false)

  createdAt DateTime @default(now()) @db.Timestamptz(6)

  order          CustomerOrder   @relation(fields: [orderId], references: [id], onDelete: Restrict)
  generatedBy    User            @relation("HandoverGenerator", fields: [generatedById], references: [id], onDelete: Restrict)
  pickingSession PickingSession? @relation(fields: [pickingSessionId], references: [id], onDelete: SetNull)

  @@index([orderId])
  @@index([isDemo])
  @@index([pickingSessionId])
}

// ============================================================================
// Milestone 4 -- Lost-Sales Management.
//
// Three concepts this module exists to keep distinct (spec section 3) --
// never collapsed into one "lost sales" figure:
//
//   A. Warehouse unavailability  -- already fully captured by Milestone 3A's
//      PickingLine.unavailableQuantity. A supply shortfall, not yet a
//      decision or a loss.
//   B. Customer decision         -- CustomerDecisionEvent (append-only, one
//      row per decision communicated, never edited/overwritten).
//   C. Confirmed lost sale       -- LostSaleRecord. Always a separate,
//      deliberate, explicit action -- NEVER implied automatically by a
//      cancellation decision alone, and NEVER auto-derived from
//      unavailableQuantity alone.
//
// UnfulfilledDemand is the hub: one row per PickingLine whose
// unavailableQuantity > 0 at the moment picking is authorized (created
// automatically, from inside the existing lib/picking/authorize-picking.ts
// transaction -- additive only, no new API route needed for creation). A
// fully-available line creates none at all (test scenario 1).
// ============================================================================

// The 7 decision outcomes a salesperson can actually RECORD (spec 4.2's
// list item 1, "pending customer decision", is deliberately NOT a value
// here -- it is the absence of any CustomerDecisionEvent, represented by
// UnfulfilledDemandStatus.PENDING_DECISION, never by an event that would
// contradict itself by recording "no decision").
//
// AWAIT_REMAINING_QUANTITY and SCHEDULE_LATER_SUPPLY are kept as two
// distinct values (matching the spec's own separate list items 3 and 4)
// even though both move quantity into the same outstandingQuantity bucket
// -- they differ in customer commitment/semantics and reporting, not in
// quantity accounting.
enum CustomerDecisionType {
  ACCEPT_PARTIAL_CANCEL_REMAINDER // outcome 2: accept what was found, cancel the rest
  AWAIT_REMAINING_QUANTITY // outcome 3: customer agrees to wait, no firm commitment
  SCHEDULE_LATER_SUPPLY // outcome 4: remaining quantity committed to be supplied later
  SUBSTITUTE_ACCEPTED // outcome 5
  PARTIAL_CANCELLATION // outcome 6: cancel part of the remaining undecided/outstanding quantity
  ENTIRE_LINE_CANCELLED // outcome 7: cancel the entire remaining quantity on this line
  ENTIRE_ORDER_CANCELLED // outcome 8: scoped to THIS UnfulfilledDemand only -- deliberately
  // does not cascade to other order lines or change OrderStatus (see
  // lib/lost-sales/record-decision.ts's own comment); recording it against
  // every unresolved UnfulfilledDemand on an order is a salesperson/UI
  // workflow concern, not something this schema enforces automatically.
}

// Spec 4.2: "Do not assume that a salesperson's entry is automatically
// proof of a customer's decision. Record the source of the decision."
// SALESPERSON_JUDGEMENT_UNCONFIRMED exists specifically so that case is a
// visible, honest, filterable value rather than silently defaulting to
// looking like a confirmed customer decision.
enum DecisionSource {
  CUSTOMER_PHONE_CALL
  CUSTOMER_EMAIL
  CUSTOMER_WRITTEN_COMMUNICATION
  CUSTOMER_IN_PERSON
  CUSTOMER_PORTAL_OR_SYSTEM
  SALESPERSON_JUDGEMENT_UNCONFIRMED
  OTHER
}

// Priority-ordered derived status (lib/lost-sales/validation.ts's
// deriveUnfulfilledDemandStatus()), stored (not computed on read) so it is
// directly filterable/indexable for the UI (spec section 6's "make it easy
// to identify...") and for reporting (section 7). Recomputed and persisted
// every time a decision event or lost-sale record changes this row's
// quantity buckets -- never hand-set.
//
// Priority order (first match wins -- zero overlap by construction):
//   1. PENDING_DECISION      -- any undecided remainder > 0
//   2. AWAITING_SUPPLY       -- fully decided, outstandingQuantity > 0
//   3. PARTIALLY_CANCELLED   -- fully decided, no outstanding, 0 < cancelled < unavailable
//   4. FULLY_CANCELLED       -- cancelled == unavailable, not yet all confirmed lost
//   5. CONFIRMED_LOST        -- confirmedLost == cancelled == unavailable
//   6. RESOLVED              -- fully decided via substitution only, nothing outstanding/cancelled
enum UnfulfilledDemandStatus {
  PENDING_DECISION
  AWAITING_SUPPLY
  PARTIALLY_CANCELLED
  FULLY_CANCELLED
  CONFIRMED_LOST
  RESOLVED
}

// Spec 4.6's configurable loss-reason list.
enum LostSaleReason {
  PRODUCT_UNAVAILABLE
  INSUFFICIENT_QUANTITY
  CUSTOMER_CANCELLED
  CUSTOMER_SOURCED_ELSEWHERE
  DELIVERY_OR_TIMING_ISSUE
  QUALITY_RELATED_ISSUE
  SUBSTITUTE_REJECTED
  OTHER // reasonDetail is required (validated in lib/lost-sales/validation.ts) when this is used
}

// Spec 4.6: "Do not assume the financial value of a lost sale from the
// warehouse's unavailable quantity alone... Clearly label estimated values
// as estimates. Do not invent prices." Both estimatedUnitPrice/Value on
// LostSaleRecord stay null (never defaulted to 0) unless one of these two
// real, historically-valid sources actually resolves.
enum LostSaleValueSource {
  ORDER_LINE_APPROVED_PRICE // OrderLine.approvedUnitPrice, tried first
  PRICE_LIST_ENTRY // most recent valid PriceListEntry as of confirmedAt, tried second
}

// One row per PickingLine with unavailableQuantity > 0, created
// automatically at authorization time (never manually) by
// lib/picking/authorize-picking.ts. @@unique([pickingLineId]) is the
// structural guarantee against duplicates; a later re-pick creates a new
// PickingSession/PickingLine (Milestone 3A's existing history-preserving
// design) and therefore its own separate UnfulfilledDemand, leaving any
// earlier one -- and its full decision history -- completely untouched.
//
// requestedQuantity/foundQuantity/unavailableQuantity are snapshots taken
// once at creation and never written again (same convention as
// PickingLine.requestedQuantity and OrderLine.sapItemCodeSnapshot), so this
// row stays an honest historical record even if upstream data changes
// later. The original CustomerOrder/OrderLine/PickingLine are never
// overwritten by anything in this module (spec section 5).
//
// Quantity-bucket invariant (enforced in lib/lost-sales/validation.ts,
// never trusted to the database alone, re-checked on every write):
//   outstandingQuantity + cancelledQuantity + substitutedQuantity
//     + <undecided remainder, not its own column> == unavailableQuantity
// confirmedLostQuantity is NOT a fifth independent bucket -- it is always
// a subset of cancelledQuantity (confirmedLostQuantity <= cancelledQuantity),
// since lib/lost-sales/confirm-lost-sale.ts is allowed to draw a lost-sale
// confirmation from either already-cancelled quantity or abandoned
// outstanding quantity (spec test scenario 12, "conversion from outstanding
// demand to confirmed lost quantity"): it consumes from
// (cancelledQuantity - confirmedLostQuantity) first, then moves any
// shortfall out of outstandingQuantity into cancelledQuantity as part of
// the same transaction, so the subset invariant never breaks.
model UnfulfilledDemand {
  id String @id @default(cuid())

  // Full traceability chain -- spec 4.1's required link list, all
  // denormalized at creation time from already-authorized picking data.
  orderId          String
  orderLineId      String
  customerId       String
  pickingSessionId String
  pickingLineId    String

  productId                  String?
  sapItemCodeSnapshot        String? // from OrderLine.sapItemCodeSnapshot at creation time; null if the order line never resolved one
  productDescriptionSnapshot String // resolved the same three-way way as lib/assembly-form/resolve-line.ts (live Product name > OrderLine snapshot > customer's own original wording), frozen at creation time

  requestedQuantity Decimal @db.Decimal(18, 4) // snapshot of PickingLine.requestedQuantity

  // Snapshot of PickingLine.foundQuantity at authorization. This also IS
  // the spec's "Accepted for fulfilment" figure (spec 4.3's worked
  // example): the found quantity already proceeds through the existing
  // picking-authorization/SAP-handover pipeline regardless of any decision
  // recorded here, so no separate "accepted" column is needed -- it would
  // only ever duplicate this one.
  foundQuantity Decimal @db.Decimal(18, 4)

  // Snapshot of PickingLine.unavailableQuantity at authorization.
  // IMMUTABLE for the life of this row -- every decision below only ever
  // partitions this fixed total, never changes it.
  unavailableQuantity Decimal @db.Decimal(18, 4)

  outstandingQuantity   Decimal @default(0) @db.Decimal(18, 4)
  cancelledQuantity     Decimal @default(0) @db.Decimal(18, 4)
  substitutedQuantity   Decimal @default(0) @db.Decimal(18, 4)
  confirmedLostQuantity Decimal @default(0) @db.Decimal(18, 4)

  status UnfulfilledDemandStatus @default(PENDING_DECISION)

  // Spec 4.4. Only ever set by an AWAIT_REMAINING_QUANTITY/
  // SCHEDULE_LATER_SUPPLY decision event; left null otherwise.
  expectedFollowUpDate DateTime? @db.Date
  followUpRemarks      String?

  isDemo Boolean @default(false)

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  order          CustomerOrder  @relation(fields: [orderId], references: [id], onDelete: Restrict)
  orderLine      OrderLine      @relation(fields: [orderLineId], references: [id], onDelete: Restrict)
  customer       Customer       @relation(fields: [customerId], references: [id], onDelete: Restrict)
  pickingSession PickingSession @relation(fields: [pickingSessionId], references: [id], onDelete: Restrict)
  pickingLine    PickingLine    @relation(fields: [pickingLineId], references: [id], onDelete: Restrict)
  product        Product?       @relation(fields: [productId], references: [id], onDelete: SetNull)

  decisionEvents  CustomerDecisionEvent[]
  lostSaleRecords LostSaleRecord[]

  @@unique([pickingLineId])
  @@index([orderId])
  @@index([customerId])
  @@index([productId])
  @@index([status])
  @@index([isDemo])
}

// Append-only -- every decision communicated is its own permanent row,
// never edited/overwritten (same convention as ExtractionRun/OrderHandover),
// so the full history survives even when a later decision supersedes an
// earlier one in effect (e.g. a customer who first agreed to wait later
// cancels the remainder). quantity is validated at recording time (in
// lib/lost-sales/record-decision.ts) against whatever undecided amount
// actually remains on the parent UnfulfilledDemand at that moment --
// never against a stale client-supplied figure.
//
// Substitution is folded into this row rather than a separate table: a
// substitution is always exactly 1:1 with one SUBSTITUTE_ACCEPTED event,
// so the handful of substitute-specific fields below are simply nullable,
// avoiding an extra model/dependency the spec explicitly warns against
// introducing unnecessarily (section 9).
model CustomerDecisionEvent {
  id                  String               @id @default(cuid())
  unfulfilledDemandId String
  decisionType        CustomerDecisionType
  source              DecisionSource

  // Portion of the parent's undecided remainder this event resolves.
  quantity Decimal @db.Decimal(18, 4)

  // Populated only when decisionType == SUBSTITUTE_ACCEPTED.
  substituteProductId                  String?
  substituteSapItemCodeSnapshot        String?
  substituteProductDescriptionSnapshot String?

  customerContactName String? // who communicated the decision, where available (spec 4.2)
  reason              String?
  remarks             String?
  attachmentReference String? // free-text reference to supporting attachment/communication (e.g. an OrderDocument id, email subject/message-id) -- spec 4.2

  decidedAt    DateTime @db.Timestamptz(6) // when the customer actually decided -- may predate recordedAt
  recordedById String
  recordedAt   DateTime @default(now()) @db.Timestamptz(6)

  unfulfilledDemand UnfulfilledDemand @relation(fields: [unfulfilledDemandId], references: [id], onDelete: Restrict)
  substituteProduct Product?          @relation("SubstituteProductRef", fields: [substituteProductId], references: [id], onDelete: SetNull)
  recordedBy        User              @relation("DecisionRecorder", fields: [recordedById], references: [id], onDelete: Restrict)

  @@index([unfulfilledDemandId])
  @@index([decisionType])
  @@index([recordedById])
}

// A genuine, confirmed lost sale -- always its own deliberate action
// (lib/lost-sales/confirm-lost-sale.ts), role-gated to
// SALES_MANAGER/ADMINISTRATOR at the API route (same two-tier pattern as
// Milestone 3A's authorizePickingSession: never automatically implied by a
// cancellation decision alone, enforced at the route, not duplicated into
// the lib function itself).
//
// All traceability (product/SAP code, customer, original order) is reached
// through unfulfilledDemand -- not duplicated here, consistent with
// avoiding disconnected records (spec 4.1) and with this codebase's
// existing "don't denormalize what a relation already gives you" style.
model LostSaleRecord {
  id                  String @id @default(cuid())
  unfulfilledDemandId String

  // Drawn from (cancelledQuantity - confirmedLostQuantity) first, then any
  // shortfall from outstandingQuantity -- see UnfulfilledDemand's own
  // comment for the exact consumption rule this must satisfy.
  quantity Decimal @db.Decimal(18, 4)

  reason       LostSaleReason
  reasonDetail String? // required when reason == OTHER (lib/lost-sales/validation.ts)

  decisionSource DecisionSource // spec 4.6's "customer decision source"

  // Never invented. Both null means "no estimate available" -- displayed
  // as such, never defaulted to 0 or guessed.
  estimatedUnitPrice   Decimal?             @db.Decimal(18, 4)
  estimatedValue       Decimal?             @db.Decimal(18, 4)
  estimatedValueSource LostSaleValueSource?

  remarks String?

  confirmedById String
  confirmedAt   DateTime @default(now()) @db.Timestamptz(6)

  unfulfilledDemand UnfulfilledDemand @relation(fields: [unfulfilledDemandId], references: [id], onDelete: Restrict)
  confirmedBy       User              @relation("LostSaleConfirmer", fields: [confirmedById], references: [id], onDelete: Restrict)

  @@index([unfulfilledDemandId])
  @@index([reason])
  @@index([confirmedById])
}

// Milestone 5 (SAP Invoice Reconciliation).
//
// Connects authorized SalesFlow quantities (Milestone 3) and SAP Invoice
// Handovers (Milestone 2C/3C) to what SAP Business One actually invoiced,
// imported from an SAP export (section 3) -- SAP itself remains the sole
// system of record for invoice numbers, prices, VAT and totals (section
// 2). "Authorized quantity" for reconciliation purposes is never a new
// stored number here -- it is read live from the order's most recently
// AUTHORIZED PickingSession's PickingLine.foundQuantity, the exact same
// source lib/handover/build-handover-rows.ts already uses, so there is
// no second copy of that figure anywhere to drift out of sync (spec
// section 5's reconciliation-integrity requirement, enforced structurally
// rather than by convention, the same approach Milestone 4's quantity
// buckets took). "Invoiced quantity" is the SUM of quantityInvoiced
// across every SapInvoiceLine matched to that OrderLine whose parent
// SapInvoice is not cancelled/reversed -- see
// lib/invoice-reconciliation/reconcile.ts.

enum InvoiceLineMatchStatus {
  UNMATCHED // not yet looked at, or the matcher found nothing it was confident enough to set automatically
  AUTO_MATCHED // matched by lib/invoice-reconciliation/matching.ts's conservative, SAP-item-code-based rule
  MANUALLY_MATCHED // a human (SALES_MANAGER/ADMINISTRATOR) linked this line to an order line by hand
  CANNOT_LINK // a human explicitly decided this line has nothing to do with SalesFlow (e.g. a walk-in/cash sale) -- a resolved, terminal outcome, not an open exception
}

enum InvoiceLineMatchMethod {
  AUTOMATIC
  MANUAL
}

// Invoice-HEADER-level status. Deliberately a separate enum from any
// order-line-level concept (spec section 6: "ensure invoice-level status
// and order-line status are not confused") -- order-line reconciliation
// (NOT_YET_INVOICED/PARTIALLY_INVOICED/FULLY_INVOICED/OVER_INVOICED) is
// never stored at all; it's computed fresh by
// lib/invoice-reconciliation/reconcile.ts from authorized vs. invoiced
// quantities, the same "derive, don't store a second truth" choice
// Milestone 4 made for UnfulfilledDemandStatus.
enum InvoiceReconciliationStatus {
  UNMATCHED // not cancelled, and not one line has been matched or resolved yet -- "UNMATCHED SAP INVOICE" (section 6)
  PARTIALLY_MATCHED // some lines resolved (matched or explicitly CANNOT_LINK), at least one still plain UNMATCHED -- an open item in the queue
  RECONCILIATION_REQUIRED // every line has been looked at, but something about this invoice still needs a human decision (an ambiguous header match, a line matched to an order line that is already over-invoiced, etc.) -- see lib/invoice-reconciliation/matching.ts
  MATCHED // every line resolved (matched or explicitly CANNOT_LINK) with nothing flagged for investigation
  CANCELLED_REVERSED // isCancelledOrReversed is true -- always wins over the line-based states above; its matches (if any) never count toward valid invoiced quantities (section 6)
}

// One row per confirmed invoice-export upload (section 10.A's "View
// import history"). Preview is stateless (mirrors every Milestone 1
// master-data importer -- the file is re-sent and re-parsed at confirm
// time, nothing is written until the operator actually confirms), so
// unlike Milestone 4's append-only event tables, there is no
// PENDING_REVIEW row for an import that was only previewed, never
// confirmed.
model SapInvoiceImportBatch {
  id               String @id @default(cuid())
  originalFileName String
  uploadedById     String

  // The operator's confirmed source-column -> target-field mapping,
  // preserved verbatim -- spec section 3's "preserve import audit
  // history" and "make the import adaptable to the actual SAP Business
  // One export structure" both land here: this is the proof of exactly
  // how an adaptable mapping was interpreted for this file.
  columnMapping Json

  totalRows            Int
  importedInvoiceCount Int
  importedLineCount    Int
  duplicateRowCount Int // rows skipped: same DocEntry/DocNum as an invoice already in this database
  invalidRowCount   Int // rows skipped: missing a required field (DocNum, a parseable Quantity)

  isDemo Boolean @default(false)

  createdAt DateTime @default(now()) @db.Timestamptz(6)

  uploadedBy User         @relation("InvoiceImportUploader", fields: [uploadedById], references: [id], onDelete: Restrict)
  invoices   SapInvoice[]

  @@index([uploadedById])
  @@index([isDemo])
}

// One row per distinct SAP invoice document (grouped, at import time, by
// DocEntry when the source provides one, else DocNum -- section 11's
// "use stable SAP document identifiers where available... do not rely
// solely on invoice numbers if the SAP source provides a more reliable
// unique identifier").
model SapInvoice {
  id            String @id @default(cuid())
  importBatchId String

  // Dedupe/stable-identity fields. sapDocEntry is the SAP internal
  // DocEntry (preferred, unique when present -- Postgres's unique index
  // permits any number of NULLs, so this is "unique only when provided");
  // sapDocNum is the human-facing invoice number, always required, but
  // deliberately NOT given its own DB-level unique constraint -- the
  // import planner (lib/invoice-reconciliation/plan-import.ts) checks
  // both against existing rows and within the same file BEFORE writing
  // anything, exactly mirroring lib/customer-master-import.ts's own
  // seenCodes/duplicateCodes planning step, so a genuine duplicate is
  // surfaced to the operator during preview rather than crashing on
  // insert or silently double-counting invoiced quantity.
  sapDocEntry String? @unique
  sapDocNum   String

  customerSapCode   String?
  customerName      String?
  matchedCustomerId String? // resolved automatically at import time via Customer.sapCustomerCode; never guessed when absent or ambiguous

  invoiceDate      DateTime? @db.Date
  currencyCode     String?
  documentStatusRaw String? // preserved verbatim from SAP, never normalized away

  // Derived once, at import time, from documentStatusRaw via a small,
  // explicit keyword rule (lib/invoice-reconciliation/csv.ts) -- never
  // silently inferred anywhere else. Always shown next to the raw value
  // in the UI so a misclassification is correctable by re-importing with
  // a clearer source value, not by editing this flag directly.
  isCancelledOrReversed Boolean @default(false)

  sapOrderReference String? // raw "reference to the originating order," where SAP provides one -- a strong matching signal, never the only one considered

  // Convenience denormalization: set only when every one of this
  // invoice's lines agreed on the same single order. An invoice spanning
  // several SalesFlow orders (section 4, explicitly supported) leaves
  // this null -- the line-level matches remain the only authoritative
  // record; never used for quantity math, only for quick list display.
  matchedOrderId String?

  // Captured as actual SAP-sourced values, never computed from handover
  // or lost-sale data (section 8's explicit prohibition).
  subtotal Decimal? @db.Decimal(18, 4)
  taxTotal Decimal? @db.Decimal(18, 4)
  total    Decimal? @db.Decimal(18, 4)

  reconciliationStatus InvoiceReconciliationStatus @default(UNMATCHED)

  // Free-text operator note on this invoice's exceptions as a whole
  // (section 7's "record explanations for discrepancies"). Every change
  // to it is itself audited via AuditEvent (before/after), same as every
  // other milestone's "record an explanation" action -- this field only
  // ever holds the CURRENT note; the full history lives in AuditEvent.
  reconciliationNotes String?

  // The complete original row(s) for this invoice's header fields, exactly
  // as uploaded (section 3's "preserve the raw source values for audit
  // and investigation... do not invent missing SAP fields").
  rawSourceData Json

  isDemo Boolean @default(false)

  createdAt DateTime @default(now()) @db.Timestamptz(6)

  importBatch     SapInvoiceImportBatch @relation(fields: [importBatchId], references: [id], onDelete: Restrict)
  matchedCustomer Customer?             @relation(fields: [matchedCustomerId], references: [id], onDelete: SetNull)
  matchedOrder    CustomerOrder?        @relation(fields: [matchedOrderId], references: [id], onDelete: SetNull)
  lines           SapInvoiceLine[]

  // Milestone 6A (Invoice Claims Management). One SAP invoice may have
  // several claims raised against it over time (spec section 1).
  claims InvoiceClaim[]

  // Milestone 6B (Returns & Credit Notes). Zero, one, or several actual
  // SAP credit notes may be recorded against this invoice over time (one
  // per settled claim, typically) -- resolved either by the operator's
  // own selection at manual-entry time or by matching a CSV-imported
  // credit note's base-invoice reference against this row.
  creditNotes CreditNote[]

  @@index([importBatchId])
  @@index([matchedCustomerId])
  @@index([matchedOrderId])
  @@index([reconciliationStatus])
  @@index([sapDocNum])
  @@index([isDemo])
}

model SapInvoiceLine {
  id           String @id @default(cuid())
  sapInvoiceId String
  lineNumber   Int // SAP's own line number where provided, else assigned sequentially at import time

  sapItemCode        String? // the primary product identity for matching (spec section 4) -- never description similarity
  sapItemDescription String?

  quantityInvoiced Decimal @db.Decimal(18, 4)
  unitOfMeasure    String?
  unitPrice        Decimal? @db.Decimal(18, 4)
  discount         Decimal? @db.Decimal(18, 4)
  taxCode          String?
  lineTotal        Decimal? @db.Decimal(18, 4)
  sapDocLineNum    String?

  rawSourceData Json

  matchedOrderId     String?
  matchedOrderLineId String?

  matchStatus InvoiceLineMatchStatus  @default(UNMATCHED)
  matchMethod InvoiceLineMatchMethod?
  matchNote   String? // for AUTO_MATCHED, a short machine-written explanation of why; for MANUALLY_MATCHED/CANNOT_LINK, the operator's own note
  matchedById String?
  matchedAt   DateTime?

  isDemo Boolean @default(false)

  createdAt DateTime @default(now()) @db.Timestamptz(6)

  sapInvoice       SapInvoice     @relation(fields: [sapInvoiceId], references: [id], onDelete: Restrict)
  matchedOrder     CustomerOrder? @relation(fields: [matchedOrderId], references: [id], onDelete: Restrict)
  matchedOrderLine OrderLine?     @relation(fields: [matchedOrderLineId], references: [id], onDelete: Restrict)
  matchedBy        User?          @relation("InvoiceLineMatcher", fields: [matchedById], references: [id], onDelete: Restrict)

  // Milestone 6A (Invoice Claims Management). Zero, one, or several
  // claim lines may be raised against one SAP invoice line over time
  // (e.g. two separate customer complaints about the same line, weeks
  // apart) -- see InvoiceClaimLine's own comment for how the "accepted +
  // rejected must not exceed invoiced" rule is enforced across all of
  // them, not just within one claim.
  claimLines InvoiceClaimLine[]

  @@index([sapInvoiceId])
  @@index([matchedOrderId])
  @@index([matchedOrderLineId])
  @@index([matchStatus])
  @@index([sapItemCode])
  @@index([isDemo])
}

// ============================================================================
// Milestone 6A -- Invoice Claims Management.
//
// Tracks what happens AFTER a customer receives a real SAP invoice
// (Milestone 5's SapInvoice/SapInvoiceLine): acceptance, partial/full
// rejection, complaints, disputed quantities/products, quality issues,
// pricing disputes -- through investigation to a resolution recommendation
// and (only once a manager approves it) an internally-approved outcome.
//
// What this milestone deliberately does NOT do (spec Part 1 section 6,
// "a recommendation is not the same as an executed action"): it never
// creates a physical return record, never marks a credit note as issued,
// never alters SAP invoice data, and never computes an "actual credited
// amount" -- those are Milestone 6B's job, built on top of this one.
// ClaimResolution.decision is the explicit, structural hook 6B reads to
// know what a claim's approved outcome implies it should do.
//
// Entirely additive: no existing table, column, or enum value changes.
// The one two-way relationship with Milestones 0-5 is a set of pure FK
// references FROM these new tables TO SapInvoice/SapInvoiceLine/
// CustomerOrder/Customer/User -- nothing on the existing side of those
// relations is ever written to by this milestone except the inverse-
// relation array field itself (no new column).
// ============================================================================

// Fixed, controlled vocabulary (confirmed choice over a DB-configurable
// list -- see docs/milestones/PROGRESS.md's Milestone 6A section):
// matches every other controlled vocabulary in this codebase
// (LostSaleReason, DecisionSource, CustomerDecisionType, ...). "OTHER"
// is the explicit escape valve the spec's own list ends with.
enum InvoiceClaimCategory {
  QUALITY_ISSUE
  DAMAGED_PRODUCTS
  SPOILAGE
  SHORT_DELIVERY
  MISSING_PRODUCTS
  WRONG_PRODUCT_SUPPLIED
  QUANTITY_DISCREPANCY
  PRICING_DISPUTE
  INCORRECT_INVOICE
  CUSTOMER_REJECTION
  OTHER
}

enum InvoiceClaimPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

// Spec Part 1 section 5's own named lifecycle, verbatim. Legal transitions
// (and which ones require SALES_MANAGER/ADMINISTRATOR) are enforced in
// lib/invoice-claims/validation.ts's validateClaimStatusTransition(), not
// just documented here -- see that file for the full transition table and
// the rationale for each edge.
enum InvoiceClaimStatus {
  OPEN
  UNDER_INVESTIGATION
  AWAITING_CUSTOMER
  AWAITING_INTERNAL_ACTION
  APPROVED
  PARTIALLY_RESOLVED
  RESOLVED
  REJECTED
  CLOSED
}

// A claim line disputes EITHER a quantity (acceptedQuantity/
// rejectedQuantity populated, disputedAmount null) OR a pure financial
// amount (disputedAmount populated, both quantities null) -- never both,
// enforced in validation.ts. Spec section 4's explicit "if the customer
// disputes only a financial amount rather than quantity, support an
// amount-based dispute without inventing a quantity."
enum ClaimLineDisputeType {
  QUANTITY
  AMOUNT_ONLY
}

// Spec Part 1 section 6's own named list, verbatim (reworded to valid
// enum identifiers). A RESOLUTION IS A RECOMMENDATION, not an executed
// action -- see ClaimResolution's own comment. The mapping from a
// decision to the claim's resulting status (once a manager approves it)
// is an explicit, exhaustive function
// (resolutionDecisionToClaimStatus() in validation.ts), never a free
// choice at approval time -- this is what makes "do not allow arbitrary
// status changes that bypass required investigation or approval steps"
// (spec section 5) structurally true rather than merely a convention.
enum ClaimResolutionDecision {
  NO_ACTION_REQUIRED
  CLAIM_REJECTED
  REPLACEMENT_APPROVED
  PHYSICAL_RETURN_REQUIRED
  PARTIAL_CREDIT_RECOMMENDED
  FULL_CREDIT_RECOMMENDED
  PRICING_CORRECTION_REQUIRED
  DELIVERY_INVESTIGATION_REQUIRED
  OTHER
}

model InvoiceClaim {
  id             String @id @default(cuid())
  claimReference String @unique // human-facing, e.g. "CLM-20261111-A1B2C3D4" -- same date+random shape as generateOrderReference()/generateHandoverReference()

  // Required: "A claim must always be linked to the relevant SAP
  // invoice" (spec section 1). orderId is nullable: "and, where
  // possible, the original SalesFlow order and invoice line" -- an
  // invoice that Milestone 5 never matched to an order can still have a
  // claim raised against it.
  sapInvoiceId String
  orderId      String?

  // Required, and NOT always the same as sapInvoice.matchedCustomerId:
  // Milestone 5 allows an invoice to import with no resolved customer
  // match at all (an unmatched SAP customer code), but a real person
  // filing a claim always knows who the customer actually is. Validated
  // at creation (lib/invoice-claims/create-claim.ts): if the invoice
  // already has a matchedCustomerId, this must equal it -- a claim can
  // never silently contradict Milestone 5's own resolved match; it may
  // only supply the identity Milestone 5 itself left unresolved.
  customerId String

  customerComplaintReference String? // the customer's own reference number, if they supplied one -- never invented
  category                   InvoiceClaimCategory
  description                String
  reportedById                String
  assignedToId                String? // "assigned person/team" -- a specific User; this codebase has no separate Team entity, so a team assignment is represented as a free-text note in customerCommunicationNotes/description if needed, not a new model
  priority                    InvoiceClaimPriority @default(MEDIUM)

  claimDate DateTime @db.Date // when the claim was reported -- distinct from sapInvoice.invoiceDate, which is read live, never duplicated here

  status     InvoiceClaimStatus @default(OPEN)
  resolvedAt DateTime?          @db.Timestamptz(6) // set once status first reaches RESOLVED/PARTIALLY_RESOLVED/REJECTED -- feeds "average resolution time" reporting without needing a full event-sourced history table
  closedAt   DateTime?          @db.Timestamptz(6)

  // Current value only, same convention as SapInvoice.reconciliationNotes
  // -- the full history of every change lives in AuditEvent, not here.
  customerCommunicationNotes String?

  isDemo Boolean @default(false)

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  sapInvoice SapInvoice     @relation(fields: [sapInvoiceId], references: [id], onDelete: Restrict)
  order      CustomerOrder? @relation(fields: [orderId], references: [id], onDelete: Restrict)
  customer   Customer       @relation(fields: [customerId], references: [id], onDelete: Restrict)
  reportedBy User           @relation("ClaimReporter", fields: [reportedById], references: [id], onDelete: Restrict)
  assignedTo User?          @relation("ClaimAssignee", fields: [assignedToId], references: [id], onDelete: Restrict)

  lines       InvoiceClaimLine[]
  resolutions ClaimResolution[]
  attachments InvoiceClaimAttachment[]

  // Milestone 6B (Returns & Credit Notes). Zero, one, or several actual
  // credit notes/physical returns may be recorded against this claim over
  // time -- never required to appear together (see ClaimReturn/CreditNote's
  // own comments), and never implying this claim has reached a concluded
  // status by themselves: only
  // lib/returns-credits/status-recompute.ts's recomputeClaimStatusAfterActuals(),
  // which still only ever moves the claim through
  // validateClaimStatusTransition(), does that.
  creditNotes CreditNote[]
  returns     ClaimReturn[]

  @@index([sapInvoiceId])
  @@index([orderId])
  @@index([customerId])
  @@index([status])
  @@index([category])
  @@index([reportedById])
  @@index([assignedToId])
  @@index([claimDate])
  @@index([isDemo])
}

model InvoiceClaimLine {
  id      String @id @default(cuid())
  claimId String

  sapInvoiceLineId String

  // Snapshotted at creation time for display without a join -- NEVER
  // used for quantity/financial math, which always re-reads the live
  // SapInvoiceLine row (same "snapshot for display, re-read live for
  // math" split OrderLine.sapItemCodeSnapshot already established).
  sapItemCodeSnapshot        String?
  sapItemDescriptionSnapshot String?

  disputeType ClaimLineDisputeType

  // Populated when disputeType == QUANTITY; both null for AMOUNT_ONLY.
  // Enforced live in lib/invoice-claims/validation.ts against the
  // invoice line's own quantityInvoiced MINUS whatever every OTHER claim
  // line against that same SapInvoiceLine has already accepted/rejected
  // (a live aggregate, never a stored running total) -- spec section 4:
  // "accepted quantity + rejected/disputed quantity must not exceed the
  // invoiced quantity," read as a rule over the invoice line as a whole,
  // not just within one claim.
  acceptedQuantity Decimal? @db.Decimal(18, 4)
  rejectedQuantity Decimal? @db.Decimal(18, 4)

  // Populated when disputeType == AMOUNT_ONLY; null for QUANTITY.
  disputedAmount Decimal? @db.Decimal(18, 4)

  // What the CUSTOMER claims the price should have been -- informational
  // only, NEVER applied to SapInvoiceLine.unitPrice or any other real
  // invoice value (spec section 7's "never calculate an actual credit
  // amount based only on an estimated claim").
  disputedUnitPrice Decimal? @db.Decimal(18, 4)

  reason               String
  evidenceNotes        String? // free-text evidence description; file evidence goes through InvoiceClaimAttachment instead
  investigationOutcome String? // mutable as investigation proceeds; audited via AuditEvent on every change, same convention as SapInvoice.reconciliationNotes

  isDemo Boolean @default(false)

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  claim          InvoiceClaim   @relation(fields: [claimId], references: [id], onDelete: Restrict)
  sapInvoiceLine SapInvoiceLine @relation(fields: [sapInvoiceLineId], references: [id], onDelete: Restrict)

  attachments InvoiceClaimAttachment[]

  // Milestone 6B (Returns & Credit Notes). A physical return may
  // optionally be scoped to this one disputed line rather than the claim
  // as a whole (mirroring InvoiceClaimAttachment.claimLineId's own
  // optional-scoping convention).
  returns ClaimReturn[]

  // Prevents the same invoice line being listed twice within the SAME
  // claim by mistake -- a genuinely new dispute about an already-claimed
  // line is always a new ClaimLine on a new or existing claim with its
  // own reason, never a silent duplicate row.
  @@unique([claimId, sapInvoiceLineId])
  @@index([claimId])
  @@index([sapInvoiceLineId])
  @@index([isDemo])
}

// A recommendation, never an executed action (spec section 6, verbatim:
// "do not mark an SAP credit note as issued merely because someone
// recommends one"). Append-only: recording a new resolution never edits
// or deletes a prior one, so a claim's full investigation history --
// including a recommendation a manager did NOT approve -- is permanently
// visible. approvedById/approvedAt are set ONLY by
// lib/invoice-claims/claim-resolution.ts's approveClaimResolution(),
// restricted to SALES_MANAGER/ADMINISTRATOR at the route layer (the lib
// function itself stays role-agnostic, same two-tier convention as every
// prior milestone's approval-weight action).
model ClaimResolution {
  id      String @id @default(cuid())
  claimId String

  findings               String?
  responsibleDepartment  String? // free text -- this codebase has no separate Department entity, and inventing one was not asked for
  rootCause              String?
  correctiveAction       String?
  customerResponse       String?

  decision       ClaimResolutionDecision
  decisionDetail String? // required when decision == OTHER, same "Other requires detail" rule as LostSaleReason

  resolutionDate DateTime? @db.Date

  recordedById String
  recordedAt   DateTime  @default(now()) @db.Timestamptz(6)

  // Set only by approveClaimResolution(). approvedCreditAmount is the
  // manager's own explicit, entered figure for how much internal credit
  // exposure this resolution approves -- NEVER auto-computed from the
  // claim lines' disputed value, because a manager approving a PARTIAL
  // credit may legitimately approve less than what was disputed (spec
  // section 7: "distinguish ... potential credit exposure [from]
  // approved credit exposure"). Null for a decision that implies no
  // credit at all (e.g. NO_ACTION_REQUIRED, CLAIM_REJECTED).
  approvedById         String?
  approvedAt           DateTime?
  approvedCreditAmount Decimal?  @db.Decimal(18, 4)

  // Set only by rejectClaimResolution() -- a manager explicitly declining
  // THIS recommendation (with a required reason), as distinct from it
  // simply being superseded by a newer one. Mutually exclusive with
  // approvedById/approvedAt in practice (enforced in
  // lib/invoice-claims/claim-resolution.ts, not by a DB constraint,
  // since Postgres has no simple "these columns are mutually exclusive"
  // check across nullable columns without a trigger). Rejecting a
  // resolution does NOT by itself change the claim's own status --
  // someone still records a new resolution or moves the claim's status
  // explicitly.
  rejectedById    String?
  rejectedAt      DateTime?
  rejectionReason String?

  isDemo Boolean @default(false)

  claim      InvoiceClaim @relation(fields: [claimId], references: [id], onDelete: Restrict)
  recordedBy User         @relation("ClaimResolutionRecorder", fields: [recordedById], references: [id], onDelete: Restrict)
  approvedBy User?        @relation("ClaimResolutionApprover", fields: [approvedById], references: [id], onDelete: Restrict)
  rejectedBy User?        @relation("ClaimResolutionRejecter", fields: [rejectedById], references: [id], onDelete: Restrict)

  @@index([claimId])
  @@index([decision])
  @@index([isDemo])
}

// Reuses the existing generic StorageDriver (lib/storage/) exactly as
// OrderDocument/OrderHandover already do -- same key-based, no-client-
// visible-path security boundary, no new storage concept introduced.
// Attachable either to the claim as a whole (claimLineId null) or to one
// specific disputed line.
model InvoiceClaimAttachment {
  id          String  @id @default(cuid())
  claimId     String
  claimLineId String?

  originalFileName String
  storageKey       String  @unique
  mimeType         String
  fileSize         BigInt
  checksum         String?

  uploadedById String
  uploadedAt   DateTime @default(now()) @db.Timestamptz(6)

  isDemo Boolean @default(false)

  claim      InvoiceClaim      @relation(fields: [claimId], references: [id], onDelete: Restrict)
  claimLine  InvoiceClaimLine? @relation(fields: [claimLineId], references: [id], onDelete: Restrict)
  uploadedBy User              @relation("ClaimAttachmentUploader", fields: [uploadedById], references: [id], onDelete: Restrict)

  @@index([claimId])
  @@index([claimLineId])
  @@index([isDemo])
}

// ============================================================================
// Milestone 6B -- Returns & Credit Notes.
//
// Builds on Milestone 6A's ClaimResolution.decision (a RECOMMENDATION) by
// recording what actually happened afterward: goods physically returned to
// the warehouse (ClaimReturn) and/or an SAP credit note SAP Business One
// itself actually issued (CreditNote). SalesFlow never creates the credit
// note in SAP -- it only records that one was issued, exactly as SAP B1
// reported it, carrying forward the same "SAP remains the sole system of
// record" rule Milestones 5 and 6A already established. Recording either
// of these can now finally advance a claim's status, but strictly through
// the SAME validated transition graph Milestone 6A already built
// (lib/invoice-claims/validation.ts's CLAIM_STATUS_TRANSITIONS) -- 6B adds
// no new status and no new transition edge; it only adds a second caller
// (lib/returns-credits/status-recompute.ts) of the one graph that already
// existed, via a shared helper factored out of
// lib/invoice-claims/claim-lifecycle.ts (applyValidatedClaimStatusChange)
// so the resolvedAt/closedAt bookkeeping can never drift between the two
// callers.
//
// Confirmed design decisions (see docs/milestones/PROGRESS.md's Milestone
// 6B section):
//  - A physical return is tracked as its own model (ClaimReturn), not just
//    a free-text note on a credit note.
//  - Recording an actual CreditNote is SALES_MANAGER/ADMINISTRATOR only --
//    it asserts a completed financial fact, the same approval-weight tier
//    as approving a ClaimResolution, not the open-to-any-user tier
//    recording a resolution recommendation itself uses. Recording a
//    physical return has no dedicated role, matching every other
//    investigation/recording-weight action in this project.
//  - Recording either a return or a credit note auto-advances the claim's
//    status when it now justifies that, never skipping a step the
//    transition graph disallows.
//  - A CSV import pipeline exists for bulk-reconciling credit notes
//    (mirroring Milestone 5's SapInvoice importer), alongside manual
//    single-record entry -- the same CreditNote model serves both; a
//    manually-entered row is created already MANUALLY_MATCHED (the
//    recording user picks the claim explicitly), an imported row starts
//    UNMATCHED and is resolved by the same "exact identity, never guess
//    ambiguity" matching rule Milestone 5 established.
//
// Entirely additive: no existing table, column, or enum value changes.
// ============================================================================

// A customer's own stated reason the goods are unsellable as received --
// never inferred from ClaimResolution.decision, since that is a different
// fact (what was internally decided to do) from this one (what the
// warehouse actually found when the goods came back).
enum ReturnCondition {
  GOOD_RESALABLE
  DAMAGED
  EXPIRED
  OTHER
}

// Mirrors InvoiceLineMatchStatus's shape (Milestone 5) but scoped to its
// own entity -- see CreditNote's own comment for exactly how a row reaches
// each state.
enum CreditNoteMatchStatus {
  UNMATCHED
  AUTO_MATCHED
  MANUALLY_MATCHED
  CANNOT_LINK
}

// One row per confirmed credit-note CSV upload -- same stateless-preview,
// write-only-on-confirm shape as SapInvoiceImportBatch (Milestone 5): the
// file is re-parsed and re-planned at confirm time, so the preview step
// never writes anything either.
model CreditNoteImportBatch {
  id               String @id @default(cuid())
  originalFileName String
  uploadedById     String

  columnMapping Json

  totalRows               Int
  importedCreditNoteCount Int
  duplicateRowCount       Int
  invalidRowCount         Int

  isDemo Boolean @default(false)

  createdAt DateTime @default(now()) @db.Timestamptz(6)

  uploadedBy  User         @relation("CreditNoteImportUploader", fields: [uploadedById], references: [id], onDelete: Restrict)
  creditNotes CreditNote[]

  @@index([uploadedById])
  @@index([isDemo])
}

// An actual SAP-issued credit note (AR Credit Memo), recorded against the
// InvoiceClaim it settles -- either typed in by a SALES_MANAGER/
// ADMINISTRATOR who sees it on their own SAP B1 screen (importBatchId
// null, created already MANUALLY_MATCHED) or reconciled from a bulk CSV
// export (importBatchId set, starts UNMATCHED). Either way, SalesFlow
// NEVER creates this document in SAP -- it only records that SAP already
// did.
model CreditNote {
  id            String  @id @default(cuid())
  importBatchId String?

  // The credit note's own SAP identity. sapCreditNoteDocEntry mirrors
  // SapInvoice.sapDocEntry's "unique only when provided" convention;
  // sapCreditNoteDocNum is always required (typed by a human for manual
  // entry, or read from the CSV for an import -- never invented).
  sapCreditNoteDocEntry String? @unique
  sapCreditNoteDocNum   String

  // The ORIGINAL invoice this credit note is crediting, resolved (never
  // guessed) either from the operator's own selection at manual-entry time
  // (denormalized from the chosen claim's own sapInvoiceId) or from the
  // CSV's base-invoice reference columns matched against an already-
  // imported SapInvoice (lib/returns-credits/plan-import.ts). Null means
  // genuinely unresolved -- a human must supply the matching claim (whose
  // sapInvoiceId then fills this in) via the manual-match action.
  sapInvoiceId String?

  // The claim this credit note settles. Null until matched (import path);
  // always set immediately at creation for a manually-entered row.
  claimId String?

  matchStatus CreditNoteMatchStatus  @default(UNMATCHED)
  matchMethod InvoiceLineMatchMethod?
  matchNote   String?
  matchedById String?
  matchedAt   DateTime?

  creditNoteDate DateTime? @db.Date
  currencyCode   String?

  // The actual amount SAP credited -- required; a credit note with no
  // amount is meaningless. Never derived from ClaimResolution.
  // approvedCreditAmount (the internally-approved figure, a different fact
  // -- see lib/invoice-claims/financial.ts's actualExceedsApproved flag
  // for how the two are compared, never merged into one number).
  amount Decimal @db.Decimal(18, 4)

  notes String?

  // Preserved verbatim for an imported row (carrying forward Milestone 5's
  // "do not invent missing SAP fields" rule); null for a manually-entered
  // row, since there is no source file row to preserve.
  rawSourceData Json?

  recordedById String
  recordedAt   DateTime @default(now()) @db.Timestamptz(6)

  isDemo Boolean @default(false)

  createdAt DateTime @default(now()) @db.Timestamptz(6)

  importBatch CreditNoteImportBatch? @relation(fields: [importBatchId], references: [id], onDelete: Restrict)
  sapInvoice  SapInvoice?            @relation(fields: [sapInvoiceId], references: [id], onDelete: Restrict)
  claim       InvoiceClaim?          @relation(fields: [claimId], references: [id], onDelete: Restrict)
  recordedBy  User                   @relation("CreditNoteRecorder", fields: [recordedById], references: [id], onDelete: Restrict)
  matchedBy   User?                  @relation("CreditNoteMatcher", fields: [matchedById], references: [id], onDelete: Restrict)

  returns ClaimReturn[]

  @@index([importBatchId])
  @@index([sapInvoiceId])
  @@index([claimId])
  @@index([matchStatus])
  @@index([isDemo])
}

// Physical goods actually received back at the warehouse against a claim
// -- a warehouse/operational fact, open to any authenticated user to
// record (same tier as recording a ClaimResolution's investigation
// findings), distinct from and never required to accompany a CreditNote
// (a straight exchange/replacement may involve a return with no credit at
// all; a pricing correction may involve a credit with no physical return).
model ClaimReturn {
  id          String  @id @default(cuid())
  claimId     String
  claimLineId String?

  // Optional: set once this return has been matched to the CreditNote
  // that actually credits it. Most of this milestone's resolutions need
  // no credit at all for their return (REPLACEMENT_APPROVED/
  // PHYSICAL_RETURN_REQUIRED), so this is never required.
  creditNoteId String?

  returnReference String @unique // "RET-YYYYMMDD-8HEX", same shape as generateClaimReference()

  receivedQuantity Decimal         @db.Decimal(18, 4)
  condition        ReturnCondition
  conditionDetail  String? // required when condition == OTHER, same "Other requires detail" rule as everywhere else in this codebase
  conditionNotes   String?

  receivedDate DateTime @db.Date
  receivedById String
  receivedAt   DateTime @default(now()) @db.Timestamptz(6)

  isDemo Boolean @default(false)

  createdAt DateTime @default(now()) @db.Timestamptz(6)

  claim      InvoiceClaim      @relation(fields: [claimId], references: [id], onDelete: Restrict)
  claimLine  InvoiceClaimLine? @relation(fields: [claimLineId], references: [id], onDelete: Restrict)
  creditNote CreditNote?       @relation(fields: [creditNoteId], references: [id], onDelete: Restrict)
  receivedBy User              @relation("ClaimReturnReceiver", fields: [receivedById], references: [id], onDelete: Restrict)

  @@index([claimId])
  @@index([claimLineId])
  @@index([creditNoteId])
  @@index([isDemo])
}

// ===========================================================================
// Milestone 7 (Quotations Management).
//
// A Quotation is a proposal FROM Willsgrove TO a customer -- the mirror
// image of a CustomerOrder (an order RECEIVED FROM a customer). Spec
// section 8 is explicit that these must never be conflated, so there is
// no shared base type: a Quotation is converted into a genuinely separate
// CustomerOrder only through an explicit action
// (lib/quotations/convert-to-order.ts), never implied automatically by
// ACCEPTED status alone.
//
// Three layers of history, deliberately not collapsed into one (mirrors
// this schema's own existing layering -- see CustomerOrder's
// receivedAt/approvedAt/... direct fields + OrderStatusHistory +
// AuditEvent):
//   - Direct fields on Quotation itself (issuedAt, respondedAt,
//     expiredAt, cancelledAt, convertedAt, ...) for fast filtering/
//     sorting/dashboard counts without joining a history table.
//   - QuotationEvent: a dedicated, purpose-built timeline for the
//     detail-page UI (spec section 7's named event list), the same role
//     OrderStatusHistory already plays for CustomerOrder -- AuditEvent
//     is this project's generic forensic log, never surfaced as a UI
//     timeline anywhere in this codebase (confirmed: grepped for reads
//     of it and found none), so a dedicated table is the established
//     pattern for a readable event history, not a new one invented here.
//   - AuditEvent: still written on every mutation, same as every other
//     milestone, for forensic/cross-entity audit purposes.
// ===========================================================================

// Spec section 5, "at minimum, consider" -- these 6 plus nothing else.
// EXPIRED/CANCELLED are deliberately terminal (see
// lib/quotations/validation.ts's transition graph); a quotation that
// needs to be revised after reaching any of ISSUED/ACCEPTED/REJECTED/
// EXPIRED does so by creating a NEW Quotation row (see
// previousRevisionId/supersededAt below) rather than a 7th status value
// -- the OLD row's own status is frozen exactly as it was when revised
// ("preserve the acceptance/rejection history of previous versions",
// spec section 6), never overwritten to mean "superseded."
enum QuotationStatus {
  DRAFT
  ISSUED
  ACCEPTED
  REJECTED
  EXPIRED
  CANCELLED
}

// Spec section 7's own named event list, reworded to identifiers.
// "Sent or presented" is deliberately not its own value: this
// architecture has no email/WhatsApp send integration (explicitly out
// of scope, spec section 14), so issuing a quotation and presenting it
// to the customer are the same recorded moment -- ISSUED covers both
// rather than inventing a second event for an action this system
// cannot actually distinguish from issuing.
enum QuotationEventType {
  CREATED
  EDITED
  ISSUED
  ACCEPTED
  REJECTED
  EXPIRED
  CANCELLED
  REVISED
  CONVERTED
}

model Quotation {
  id String @id @default(cuid())

  // Shared across every revision of one lineage (spec section 6: "a
  // revised quotation must be traceable to the original quotation") --
  // the human-facing number a customer sees never changes on revision,
  // only revisionNumber does. Same "PREFIX-YYYYMMDD-8HEX" shape as
  // generateOrderReference()/generateClaimReference(), generated once
  // for revision 1 and copied forward on every later revision.
  quotationNumber String
  revisionNumber  Int    @default(1)

  // Null on the very first revision (that IS the root); non-null on
  // every later revision, pointing at the very first row in the chain --
  // lets "every revision of quotation X" be queried in one indexed pass
  // without walking previousRevisionId links one at a time. Deliberately
  // NOT a Prisma relation field (plain, indexed string only) -- same
  // category as sapItemCodeSnapshot elsewhere in this schema: a
  // denormalized convenience pointer set once at creation and never
  // mutated, not something that needs its own onDelete semantics (rows
  // in this table are never deleted through the application).
  rootQuotationId String?

  // The immediate prior version. @unique: at most one later revision can
  // ever point back to a given quotation, which is exactly what makes
  // "create a second revision from an already-revised version" a
  // straightforward conflict to detect (lib/quotations/revise.ts checks
  // this, not just supersededAt, as the authoritative guard).
  previousRevisionId String? @unique

  // Set on THIS row the moment a NEW revision is created from it (i.e.
  // written onto the OLD row, pointing at who/when revised it -- the new
  // row's own id is reachable via previousRevisionId from the other
  // side). "Do not allow an old version to be mistaken for the currently
  // issued quotation" (spec section 6) is enforced by every list/
  // dashboard query excluding supersededAt: { not: null } by default,
  // not by changing status.
  supersededAt DateTime? @db.Timestamptz(6)
  supersededById String?

  customerId        String
  customerContactId String?

  quotationDate DateTime @db.Date
  validUntil    DateTime @db.Date

  currency String @default("USD") // "USD" | "ZWG", same free-string convention as Customer.currencyCode/CustomerOrder.currency

  customerReference String? // the customer's own RFQ/reference number, if they supplied one -- never invented, same convention as InvoiceClaim.customerComplaintReference

  preparedById  String // who prepared this quotation
  salespersonId String // the assigned salesperson -- may differ from preparedById (a manager can prepare on a salesperson's behalf)

  status QuotationStatus @default(DRAFT)

  internalNotes String? // staff-only
  customerNotes String? // "customer-facing notes and terms" -- printed on the document

  // Spec section 4's calculations, STORED (not computed live) -- same
  // reason CustomerOrder.subtotal/taxTotal/total and OrderLine.lineTotal
  // are stored, not derived-on-read: once ISSUED, these values must
  // never silently drift if catalogue prices or VAT rates change later
  // ("preserve the original quotation values after issue," spec section
  // 4). Recomputed by lib/quotations/calculations.ts on every DRAFT
  // edit; frozen the instant status leaves DRAFT, because no API path
  // can edit lines/header once a quotation is no longer DRAFT.
  subtotal       Decimal @db.Decimal(18, 4) @default(0)
  discountTotal  Decimal @db.Decimal(18, 4) @default(0)
  vatTotal       Decimal @db.Decimal(18, 4) @default(0)
  total          Decimal @db.Decimal(18, 4) @default(0)

  issuedAt   DateTime? @db.Timestamptz(6)
  issuedById String?

  // Customer response (spec section 7).
  respondedAt               DateTime? @db.Timestamptz(6)
  respondedById             String? // who in SalesFlow recorded the response -- never the customer themselves
  responseNotes             String?
  rejectionReason           String?
  customerResponseReference String? // evidence/reference the customer gave (a confirmation email ref, a PO number) -- never invented when absent

  // Follow-up tracking (spec section 7). "A quotation that has been
  // issued but has no recorded response should remain identifiable as
  // awaiting customer feedback" -- lib/quotations/queries.ts's dashboard
  // counts read status === ISSUED && respondedAt === null live, never a
  // separate stored flag that could drift from these two fields.
  nextFollowUpDate DateTime? @db.Date
  followUpNotes    String?

  expiredAt DateTime? @db.Timestamptz(6) // set only by the explicit expiry action (lib/quotations/expiry.ts) -- never implied by validUntil alone; see that file's own comment

  cancelledAt        DateTime? @db.Timestamptz(6)
  cancelledById      String?
  cancellationReason String?

  // Conversion into a real CustomerOrder (spec section 8). @unique:
  // structurally guarantees at most one order is ever created from a
  // given quotation, which is what makes "avoid duplicate orders" a
  // database-enforced fact rather than a convention -- see
  // lib/quotations/convert-to-order.ts.
  convertedOrderId String? @unique
  convertedAt      DateTime? @db.Timestamptz(6)
  convertedById    String?

  isDemo Boolean @default(false)

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  customer        Customer         @relation(fields: [customerId], references: [id], onDelete: Restrict)
  customerContact CustomerContact? @relation(fields: [customerContactId], references: [id], onDelete: SetNull)
  preparedBy      User             @relation("QuotationPreparer", fields: [preparedById], references: [id], onDelete: Restrict)
  salesperson     User             @relation("QuotationSalesperson", fields: [salespersonId], references: [id], onDelete: Restrict)
  issuedBy        User?            @relation("QuotationIssuer", fields: [issuedById], references: [id], onDelete: Restrict)
  respondedBy     User?            @relation("QuotationResponseRecorder", fields: [respondedById], references: [id], onDelete: Restrict)
  cancelledBy     User?            @relation("QuotationCanceller", fields: [cancelledById], references: [id], onDelete: Restrict)
  supersededBy    User?            @relation("QuotationSuperseder", fields: [supersededById], references: [id], onDelete: Restrict)
  convertedBy     User?            @relation("QuotationConverter", fields: [convertedById], references: [id], onDelete: Restrict)

  previousRevision Quotation? @relation("QuotationRevisionChain", fields: [previousRevisionId], references: [id], onDelete: Restrict)
  nextRevision     Quotation? @relation("QuotationRevisionChain")

  convertedOrder CustomerOrder? @relation("QuotationConvertedOrder", fields: [convertedOrderId], references: [id], onDelete: Restrict)

  lines  QuotationLine[]
  events QuotationEvent[]

  // Milestone 8 (Validation and Approvals). Every ApprovalRequest ever
  // raised against THIS quotation id (never the whole revision lineage --
  // a revision is a new row with its own id, so it gets its own fresh
  // gate check, exactly like it gets its own DRAFT lines). See
  // lib/approvals/quotation-gate.ts.
  approvalRequests ApprovalRequest[] @relation("QuotationApprovalRequests")

  // Milestone 10 (Communication Channels & Fulfilment). Same pattern as
  // CustomerOrder's own linkedMessageIntakes/outboundMessages above.
  linkedMessageIntakes MessageIntake[]
  outboundMessages     OutboundMessage[]

  @@unique([quotationNumber, revisionNumber])
  @@index([quotationNumber])
  @@index([rootQuotationId])
  @@index([customerId])
  @@index([status])
  @@index([quotationDate])
  @@index([validUntil])
  @@index([salespersonId])
  @@index([preparedById])
  @@index([supersededAt])
  @@index([nextFollowUpDate])
  @@index([isDemo])
}

model QuotationLine {
  id          String @id @default(cuid())
  quotationId String
  lineNumber  Int

  // Exactly one of (productId set, isUnlistedItem false) or
  // (productId null, isUnlistedItem true, unlistedItemDescription set)
  // -- enforced in lib/quotations/validation.ts, same "no DB CHECK
  // constraint" convention this entire schema already follows for every
  // other conditional business rule (e.g. ClaimLineDisputeType's
  // quantity-vs-amount split). Spec section 3: "must not be treated as
  // an SAP product or silently assigned a fabricated code."
  productId                  String?
  sapItemCodeSnapshot        String? // null for an unlisted item -- never fabricated
  sapItemDescriptionSnapshot String? // snapshotted at line-add time so an issued quotation's printed description can never drift if the catalogue description changes later
  isUnlistedItem             Boolean @default(false)
  unlistedItemDescription    String? // the customer's own wording for a requested-but-not-catalogued item

  quantity      Decimal @db.Decimal(18, 4)
  unitOfMeasure String? // "where available" -- defaults from Product.unitOfMeasure, overridable

  // "Sales determines selling prices... do not invent selling prices
  // from purchase costs, SAP stock values or historical prices" (spec
  // section 4) -- always manually entered/verified by the salesperson,
  // never looked up or suggested from PriceListEntry.
  unitPrice       Decimal  @db.Decimal(18, 4)
  discountPercent Decimal? @db.Decimal(5, 2) // 0-100; manual, sales-entered -- no approval gate (that is Milestone 8's job, spec section 4 explicitly forbids building it here)

  // VAT resolved from Product.vatCode -> TaxCode.ratePercent at the
  // moment this line is saved, then frozen -- same reasoning as
  // Quotation's own stored totals: an issued quotation's VAT must never
  // silently drift if a TaxCode's rate changes later.
  vatCodeSnapshot        String?
  vatRatePercentSnapshot Decimal? @db.Decimal(5, 2)

  lineSubtotal   Decimal @db.Decimal(18, 4) // quantity * unitPrice
  discountAmount Decimal @db.Decimal(18, 4) @default(0)
  vatAmount      Decimal @db.Decimal(18, 4) @default(0)
  lineTotal      Decimal @db.Decimal(18, 4) // lineSubtotal - discountAmount + vatAmount

  notes String?

  isDemo Boolean @default(false)

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  quotation Quotation @relation(fields: [quotationId], references: [id], onDelete: Restrict)
  product   Product?  @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@unique([quotationId, lineNumber])
  @@index([quotationId])
  @@index([productId])
  @@index([isDemo])
}

model QuotationEvent {
  id          String             @id @default(cuid())
  quotationId String
  eventType   QuotationEventType
  actorId     String?
  notes       String?

  createdAt DateTime @default(now()) @db.Timestamptz(6)

  quotation Quotation @relation(fields: [quotationId], references: [id], onDelete: Restrict)
  actor     User?     @relation("QuotationEventActor", fields: [actorId], references: [id], onDelete: Restrict)

  @@index([quotationId])
  @@index([eventType])
}

// ===========================================================================
// Milestone 8 (Validation and Approvals).
//
// ONE reusable, cross-module approval framework -- not a separate approval
// implementation per module (spec section 2). The legacy M0 trio
// (ProductVerification/PriceDecision/OrderApproval above) is left
// untouched and still unused: it has zero requester/reason/evidence/
// previous-value fields, no DRAFT/CANCELLED/WITHDRAWN states, and is
// siloed per order-line/order, so it is not a safe foundation to extend
// for a framework meant to serve Quotations (and, schema-ready,
// CustomerOrder) alike. Confirmed by grep before this migration: no
// lib/ or app/api code anywhere creates, reads, or transitions those
// three models or ProductVerification/PriceDecision/OrderApproval's own
// enums -- the only reference outside the schema is a defensive no-op
// cleanup in scripts/remove-demo-data.ts.
//
// Integrity strategy for "traceable to the business record" (spec
// section 2): ApprovalRequest below carries REAL, nullable, typed FK
// columns -- one per supported target (quotationId, customerOrderId) --
// discriminated by `module`/`actionType`, never a generic
// entityType/entityId string pair with no referential integrity at all
// (that shape is deliberately reserved for AuditEvent's own, different
// purpose: a forensic log over every entity in this project, not a
// structure anything needs to join against or enforce). Exactly one
// typed reference is populated per row, enforced in
// lib/approvals/validation.ts (zod + a runtime check), the same "no DB
// CHECK constraint, enforced in application code" convention this
// schema already follows for every other conditional business rule
// (e.g. QuotationLine's catalogued-vs-unlisted XOR).
//
// Three layers of history, same deliberate non-collapse as every prior
// milestone (Quotation's own comment explains the pattern first):
//   - Direct fields on ApprovalRequest (submittedAt, decidedAt, ...) for
//     fast dashboard/filter queries without a history-table join.
//   - ApprovalEvent: a dedicated timeline for the detail-page UI, same
//     role QuotationEvent/OrderStatusHistory already play.
//   - AuditEvent: still written on every mutation, for forensic/cross-
//     entity audit purposes.
// ===========================================================================

// Spec section 1, "possible approval statuses," exactly these 6 -- same
// "no 7th status invented" discipline as QuotationStatus. DRAFT is
// schema-complete but not reachable through any action built in this
// milestone: every v1 trigger (lib/approvals/quotation-gate.ts) auto-
// raises a request that is already PENDING the moment a configured
// policy fires, rather than a human building one up over several saves
// first -- see docs/milestones/PROGRESS.md's Milestone 8 section for why
// DRAFT is kept in the enum (forward compatibility for a future manual-
// submission flow) rather than removed.
enum ApprovalRequestStatus {
  DRAFT
  PENDING
  APPROVED
  REJECTED
  CANCELLED
  WITHDRAWN
}

// Which part of the application a request/policy belongs to. ORDERS is
// schema/policy-ready (an ADMINISTRATOR can define an ORDER_VALUE_
// EXCEEDS_THRESHOLD policy in the Settings UI) but has NO live trigger
// wired into lib/orders.ts createOrderCore this milestone -- a deliberate
// scope decision (confirmed with the user) given that function's shared
// use by manual order entry AND the Milestone 2B/2C PO-review/multi-
// store-split flow. See PROGRESS.md's Milestone 8 "known limitations."
enum ApprovalModule {
  QUOTATIONS
  ORDERS
}

// One value per distinct business rule a policy can express. Deliberately
// NOT a generic "threshold exceeded" value reused across modules --
// each actionType names the exact rule so a policy row is self-
// explanatory without joining back to code.
enum ApprovalActionType {
  QUOTATION_DISCOUNT_EXCEEDS_THRESHOLD
  ORDER_VALUE_EXCEEDS_THRESHOLD
}

// Spec section 7's own named event list, reworded to identifiers (same
// convention as QuotationEventType). INVALIDATED is the "changes to
// material financial values after approval must invalidate... renewed
// approval" event (spec section 4A) -- it moves the request's status to
// CANCELLED (never a 7th status) while recording, distinctly from a
// human CANCELLED decision, that the system did this because the
// underlying values changed.
enum ApprovalEventType {
  SUBMITTED
  APPROVED
  REJECTED
  WITHDRAWN
  CANCELLED
  RESUBMITTED
  INVALIDATED
}

model ApprovalPolicy {
  id String @id @default(cuid())

  module     ApprovalModule
  actionType ApprovalActionType

  name        String
  description String?

  // Threshold shape kept deliberately minimal (spec section 5: "keep the
  // first version practical ... do not implement every theoretical
  // configuration option"): one percent field and one amount+currency
  // pair, each meaningful only for the actionType that uses it
  // (QUOTATION_DISCOUNT_EXCEEDS_THRESHOLD reads thresholdPercent;
  // ORDER_VALUE_EXCEEDS_THRESHOLD would read thresholdAmount/currency
  // once wired). Never both required at once -- validated in
  // lib/approvals/validation.ts, not here.
  thresholdPercent Decimal? @db.Decimal(5, 2)
  thresholdAmount  Decimal? @db.Decimal(18, 4)
  currency         String? // required when thresholdAmount is set; never converted across currencies -- no exchange-rate table exists in this schema (spec section 5's explicit instruction)

  requiredApproverRole UserRole @default(SALES_MANAGER)

  // Spec section 2/6 explicitly lists "whether the requester may
  // approve" as a configurable field -- default false (never silently
  // allow self-approval), and even when an administrator sets this true
  // for a given policy, lib/approvals/requests.ts still never lets the
  // SAME user who triggered the request decide it, nor the quotation's
  // own preparer decide a quotation-discount request (spec section 7's
  // named "preparer vs. approver" pair) -- this flag can only ever
  // widen WHO ELSE besides those two is eligible, never remove the
  // self-approval block itself.
  allowRequesterSelfApprove Boolean @default(false)

  // Spec section 5's "whether approval is mandatory." true (the only
  // value any policy created in this milestone's UI can actually be
  // given effect for) means a firing policy blocks the gated action
  // until decided. A policy somehow saved with this false would be
  // informational-only -- not wired to skip the block in v1, since no
  // code path creates or needs one yet; kept in the schema rather than
  // omitted so a future "advisory-only" policy type is additive, not a
  // migration.
  isMandatory Boolean @default(true)

  // Spec section 8's "overdue requests, where configured." Live-computed
  // at read time (lib/approvals/queries.ts), never stored on
  // ApprovalRequest itself -- same "never store what can be derived"
  // discipline as every prior milestone's own computed-status fields
  // (e.g. Quotation's expiry, SapInvoiceLine's remaining quantity). Null
  // means no SLA configured for this policy -- a request against it is
  // never flagged overdue.
  overdueAfterHours Int?

  effectiveFrom DateTime? @db.Date
  effectiveTo   DateTime? @db.Date
  active        Boolean  @default(true)

  isDemo Boolean @default(false)

  createdById String
  createdAt   DateTime @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @db.Timestamptz(6)

  createdBy User              @relation("ApprovalPolicyCreator", fields: [createdById], references: [id], onDelete: Restrict)
  requests  ApprovalRequest[]

  @@index([module, actionType, active])
  @@index([isDemo])
}

model ApprovalRequest {
  id String @id @default(cuid())

  module     ApprovalModule
  actionType ApprovalActionType
  status     ApprovalRequestStatus @default(PENDING)

  // Exactly one of these is set, matching `module`/`actionType` -- see
  // this block's own header comment on the integrity strategy. Real FK
  // relations (Postgres-enforced referential integrity), never a bare
  // (entityType, entityId) pair.
  quotationId     String?
  customerOrderId String?

  // Revision/resubmission chain -- same shape and same reasoning as
  // Quotation.previousRevisionId/rootQuotationId: @unique on
  // previousRequestId structurally guarantees at most one resubmission
  // ever points back to a given request, and rootRequestId lets "every
  // attempt in this lineage" be queried in one indexed pass.
  previousRequestId String? @unique
  rootRequestId     String?

  policyId             String? // which policy fired this -- SetNull (never cascade-delete the request) if the policy is later removed
  requiredApproverRole UserRole // snapshotted from the policy at submission time; never re-derived from a policy that might be edited or deactivated later

  requestedById String
  reason        String? // the requester's own justification, where supplied
  evidence      String? // free-text reference to supporting evidence -- no file-attachment pipeline built for this milestone (see PROGRESS.md's known limitations)

  // Spec section 2's "previous and current values for changes requiring
  // approval." previousValues is the business record's own prior state
  // where meaningful (e.g. a revision's prior discount); submittedValues
  // is the exact snapshot judged against the policy and shown to the
  // approver -- compared again, live, at the moment the gated action
  // actually executes (spec section 6: "revalidated... not merely when
  // submitted"), never trusted as still-current just because this row
  // says APPROVED.
  previousValues  Json?
  submittedValues Json

  submittedAt    DateTime  @default(now()) @db.Timestamptz(6)
  decidedAt      DateTime?
  decidedById    String?
  decisionReason String?

  withdrawnAt   DateTime?
  withdrawnById String?

  cancelledAt        DateTime?
  cancelledById       String?
  cancellationReason String?

  isDemo Boolean @default(false)

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  quotation     Quotation?      @relation("QuotationApprovalRequests", fields: [quotationId], references: [id], onDelete: Restrict)
  customerOrder CustomerOrder?  @relation("OrderApprovalRequests", fields: [customerOrderId], references: [id], onDelete: Restrict)
  policy        ApprovalPolicy? @relation(fields: [policyId], references: [id], onDelete: SetNull)

  requestedBy User  @relation("ApprovalRequester", fields: [requestedById], references: [id], onDelete: Restrict)
  decidedBy   User? @relation("ApprovalDecider", fields: [decidedById], references: [id], onDelete: Restrict)
  withdrawnBy User? @relation("ApprovalWithdrawer", fields: [withdrawnById], references: [id], onDelete: Restrict)
  cancelledBy User? @relation("ApprovalCanceller", fields: [cancelledById], references: [id], onDelete: Restrict)

  previousRequest ApprovalRequest? @relation("ApprovalRequestChain", fields: [previousRequestId], references: [id], onDelete: Restrict)
  nextRequest     ApprovalRequest? @relation("ApprovalRequestChain")

  events ApprovalEvent[]

  @@index([module])
  @@index([actionType])
  @@index([status])
  @@index([quotationId])
  @@index([customerOrderId])
  @@index([requestedById])
  @@index([decidedById])
  @@index([submittedAt])
  @@index([rootRequestId])
  @@index([isDemo])
}

model ApprovalEvent {
  id                String            @id @default(cuid())
  approvalRequestId String
  eventType         ApprovalEventType
  actorId           String?
  notes             String?

  createdAt DateTime @default(now()) @db.Timestamptz(6)

  approvalRequest ApprovalRequest @relation(fields: [approvalRequestId], references: [id], onDelete: Restrict)
  actor           User?           @relation("ApprovalEventActor", fields: [actorId], references: [id], onDelete: Restrict)

  @@index([approvalRequestId])
  @@index([eventType])
}

// Spec section 9: "if the application has no notification
// infrastructure, implement an appropriate internal notification
// mechanism." Confirmed by grep before this migration: none existed.
// Deliberately minimal (in-app only, polled on page load -- no
// websocket/real-time push anywhere else in this codebase either, and
// email/WhatsApp are explicitly out of scope for this milestone, spec
// section 9/14) but a real, persisted, per-user model, not a
// hand-waved "document the dependency" punt, since the spec gives that
// as the fallback only when no mechanism is built.
enum NotificationType {
  APPROVAL_SUBMITTED
  APPROVAL_APPROVED
  APPROVAL_REJECTED
  APPROVAL_WITHDRAWN
  APPROVAL_OVERDUE

  // Milestone 10 (Communication Channels & Fulfilment). CHANNEL_INTAKE_
  // RECEIVED notifies staff that a new email/WhatsApp MessageIntake is
  // waiting for human review (never auto-converted -- see MessageIntake's
  // own comment). OUTBOUND_MESSAGE_FAILED notifies staff that a queued
  // customer communication reached OutboundMessageStatus.FAILED and needs
  // either a manual Resend or a phone-call follow-up.
  CHANNEL_INTAKE_RECEIVED
  OUTBOUND_MESSAGE_FAILED
}

model Notification {
  id      String           @id @default(cuid())
  userId  String
  type    NotificationType
  title   String
  message String
  link    String? // relative app path, e.g. "/approvals/{id}" -- never an absolute URL, never SAP/external

  readAt DateTime?

  isDemo Boolean @default(false)

  createdAt DateTime @default(now()) @db.Timestamptz(6)

  // Cascade: a notification has no meaning once its recipient's own
  // account is gone -- same reasoning as Session's own onDelete: Cascade,
  // and unlike every business record in this schema (Restrict), because
  // a Notification is purely a per-user inbox item, never a business
  // fact anyone else needs to trace.
  user User @relation("NotificationRecipient", fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt])
  @@index([createdAt])
  @@index([isDemo])
}

// Milestone 9 (SAP Business One Integration). SAP Business One remains
// authoritative for product/customer master data, inventory, financial
// accounting, SAP sales orders, SAP invoices and SAP credit notes (spec
// section 3) -- nothing below duplicates or overrides that. These four
// models exist purely to make SalesFlow's OWN side of the integration
// durable, auditable and idempotent: what was synced, when, by what
// mechanism, with what outcome, and (for the one outbound write this
// milestone performs -- submitting a SAP sales order) exactly what was
// sent and whether SAP's response can be trusted.
//
// Deliberately NOT built as a generic polymorphic entityType/entityId
// reference system (spec section 7's explicit instruction against that):
// IntegrationOperation.customerOrderId is a real, typed, Restrict foreign
// key onto CustomerOrder -- the only outbound business object this
// milestone submits -- not a generic "entity" pointer. Inbound sync
// (products, customers, invoices, credit notes) reuses the EXISTING
// Milestone 1/5/6B models and import pipelines unchanged (Product/
// Customer upsert via lib/product-import.ts/lib/customer-master-import.ts;
// SapInvoiceImportBatch/SapInvoice/SapInvoiceLine via lib/invoice-
// reconciliation/*; CreditNoteImportBatch/CreditNote via lib/returns-
// credits/*) -- IntegrationSyncJob only wraps those existing calls with a
// job-level record (who/when/trigger/outcome) for the dashboard, and
// cross-references the resulting batch id in its own `summary` JSON
// rather than ever duplicating a single field those models already own.
//
// No IntegrationExternalReference / IntegrationSyncCursor model: the one
// external reference this milestone needs (a submitted order's SAP
// DocEntry/DocNum) lives directly as typed columns on IntegrationOperation
// itself (see spec section 7's warning against a reference table with no
// referential integrity), and incremental sync (where the real SAP
// Service Layer interface supports server-side filtering, unverified
// against a real environment -- see docs/sap-integration/
// discovery-checklist.md) is computed from the most recent COMPLETED
// IntegrationSyncJob's own `completedAt` per jobType rather than a
// separate cursor row, avoiding an unverifiable guess at what a real
// Service Layer "changed since" query actually looks like.
enum IntegrationProvider {
  SAP_B1
}

// MOCK is always available and requires no real SAP access at all (the
// deterministic MockSapAdapter -- lib/integrations/sap/mock-adapter.ts).
// LIVE only ever takes effect when BOTH this flag AND the deployment-level
// SAP_B1_PROVIDER environment variable (a kill switch only an operator
// with server access can flip, never reachable from this UI) allow it --
// see lib/integrations/sap/get-adapter.ts. Defaults to MOCK everywhere
// (spec section 6: "Default live integration to disabled").
enum IntegrationMode {
  MOCK
  LIVE
}

enum IntegrationSyncJobType {
  PRODUCT_IMPORT
  CUSTOMER_IMPORT
  INVOICE_IMPORT
  CREDIT_NOTE_IMPORT
  SALES_ORDER_OUTBOX
}

enum IntegrationSyncJobStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
  // At least one item in this job succeeded and at least one failed --
  // never silently reported as COMPLETED just because the job itself
  // didn't crash (spec section 16: standardised, honest error reporting).
  PARTIAL
}

enum IntegrationTrigger {
  MANUAL
  SCHEDULED
}

// Open to extend -- SALES_ORDER_SUBMISSION is the only outbound write
// this milestone performs (spec section 10: "the primary outbound
// integration workflow"). Inbound sync (products/customers/invoices/
// credit notes) is tracked at the IntegrationSyncJob level only, since
// each of those reuses an existing batch-level model (SapInvoiceImportBatch
// etc.) that already has its own per-row granularity -- a second,
// duplicate per-row operation log over the same rows would be exactly the
// "competing system" spec section 11 forbids.
enum IntegrationOperationType {
  SALES_ORDER_SUBMISSION
}

// PENDING: created, not yet attempted. PROCESSING: an attempt is
// currently in flight (set immediately before calling the adapter, inside
// the same transaction that reads it back out -- see
// lib/integrations/sap/order-outbox.ts -- so a crashed process can never
// leave a row silently stuck looking like nothing happened). SUCCEEDED:
// SAP confirmed creation; externalDocEntry/externalDocNum are populated.
// FAILED: a permanent rejection (validation, permission) -- safe to
// correct and resubmit, never auto-retried. UNCERTAIN: the request may or
// may not have reached SAP (timeout, dropped connection, lost response) --
// spec section 7.2's central case; requires reconciliation (a lookup by
// external reference, or an authorised human decision) before any retry,
// never a blind resubmission.
enum IntegrationOperationStatus {
  PENDING
  PROCESSING
  SUCCEEDED
  FAILED
  UNCERTAIN
}

// Standardised error categories (spec section 16) -- stored on
// IntegrationOperation.lastErrorCategory so the UI can show a meaningful,
// non-technical reason and decide whether "Retry" is even offered
// (VALIDATION_FAILURE and the two MISSING_*_MAPPING categories are
// corrected-then-resubmit, never blindly retried; TIMEOUT/NETWORK_
// UNAVAILABLE/SERVICE_UNAVAILABLE are the retryable/reconcile-first set).
enum IntegrationErrorCategory {
  AUTHENTICATION_FAILURE
  PERMISSION_DENIED
  NETWORK_UNAVAILABLE
  TIMEOUT
  VALIDATION_FAILURE
  MISSING_CUSTOMER_MAPPING
  MISSING_PRODUCT_MAPPING
  DUPLICATE_EXTERNAL_REFERENCE
  CURRENCY_MISMATCH
  INVALID_QUANTITY
  INVALID_PRICE
  UNCERTAIN_SUBMISSION
  SERVICE_UNAVAILABLE
  INTERNAL_ERROR
}

// Effectively a singleton per provider (@unique on `provider`, and this
// milestone only ever creates/reads the SAP_B1 row) rather than a
// hardcoded config object, so ADMINISTRATOR changes are real, auditable
// database writes (spec section 6: "audit configuration changes") and
// the row simply doesn't exist until the first save -- lib/integrations/
// sap/connection.ts's getOrCreateIntegrationConnection() returns an
// in-memory MOCK/disabled default when no row exists yet, so "not
// configured" and "explicitly configured as MOCK/disabled" both render
// identically and safely with no seed data required.
//
// No password/API key/session-token column exists on this model, ever --
// spec section 6: "never expose credentials to client components... never
// write secrets to ordinary logs." The real secret lives only in the
// SAP_B1_PASSWORD (or SAP_B1_API_KEY) environment variable, read
// server-side at the moment of an actual adapter call -- see
// lib/integrations/sap/config.ts. baseUrl/companyDb/username are
// configuration, not secrets, but are still never returned to a
// SALESPERSON/SALES_MANAGER session.
model IntegrationConnection {
  id       String               @id @default(cuid())
  provider IntegrationProvider  @unique @default(SAP_B1)

  mode    IntegrationMode @default(MOCK)
  enabled Boolean         @default(false)

  baseUrl   String?
  companyDb String?
  username  String?

  lastTestedAt    DateTime?
  lastTestOk      Boolean?
  lastTestMessage String? // sanitized -- a category + short reason, never a raw stack trace or secret value

  lastConnectionHealthCheckedAt DateTime?

  updatedById String?
  updatedAt   DateTime @updatedAt @db.Timestamptz(6)
  createdAt   DateTime @default(now()) @db.Timestamptz(6)

  updatedBy User? @relation("IntegrationConnectionUpdater", fields: [updatedById], references: [id], onDelete: Restrict)

  @@index([provider])
}

// One row per synchronisation run -- manual (an ADMINISTRATOR clicking
// "Sync now") or scheduled (scripts/sap-sync.ts, run by an external
// scheduler the same way scripts/expire-quotations.ts already is -- see
// SETUP-WINDOWS.md). Durable so "last successful synchronisation" (spec
// section 7's requirement) is a real query, not something only ever held
// in memory, and so a partial/failed run is visible rather than silently
// swallowed.
model IntegrationSyncJob {
  id String @id @default(cuid())

  provider IntegrationProvider     @default(SAP_B1)
  jobType  IntegrationSyncJobType
  status   IntegrationSyncJobStatus @default(PENDING)
  trigger  IntegrationTrigger

  triggeredById String?

  startedAt   DateTime?
  completedAt DateTime?

  // Job-type-specific counts/cross-references (e.g. {createdCount,
  // updatedCount, unchangedCount} for PRODUCT_IMPORT/CUSTOMER_IMPORT;
  // {importBatchId, importedInvoiceCount, ...} for INVOICE_IMPORT,
  // pointing at the real Milestone 5 SapInvoiceImportBatch row this job
  // produced; the Milestone 6B equivalent for CREDIT_NOTE_IMPORT;
  // {processedCount, succeededCount, failedCount, uncertainCount} for
  // SALES_ORDER_OUTBOX). A dashboard rollup only -- never a second source
  // of truth for anything the referenced batch/operation rows already
  // hold.
  summary Json?

  errorMessage String? // set only when the whole job itself failed before producing any per-item outcome (e.g. the adapter call itself threw) -- an ordinary per-item failure lives on that item's own row/the batch's own counts instead

  isDemo Boolean @default(false)

  createdAt DateTime @default(now()) @db.Timestamptz(6)

  triggeredBy User?                  @relation("IntegrationSyncJobTrigger", fields: [triggeredById], references: [id], onDelete: Restrict)
  operations  IntegrationOperation[]

  @@index([jobType])
  @@index([status])
  @@index([createdAt])
  @@index([isDemo])
}

// The outbox row for one CustomerOrder's SAP sales-order submission --
// spec section 7.1's reliable outgoing-operation mechanism and section
// 7.2's idempotency/duplicate-prevention requirement, both satisfied
// structurally: `customerOrderId` is @unique, so the database itself
// physically cannot hold two outbox rows for the same order, and
// `idempotencyKey` is deterministic (never random) per order, so
// regenerating it on a retry always matches this same row rather than
// drifting. `syncJobId` is nullable: a row is created the moment an order
// is submitted (ad hoc, by whoever clicked "Submit"), and only gains a
// job reference if a later batch-processing run (scripts/sap-sync.ts or
// the dashboard's own "Process pending" action) touches it.
model IntegrationOperation {
  id String @id @default(cuid())

  syncJobId String?

  operationType IntegrationOperationType
  status        IntegrationOperationStatus @default(PENDING)

  idempotencyKey String @unique

  customerOrderId String @unique

  // Immutable copy of exactly what was (or will be) submitted, captured
  // at creation time -- so a later edit elsewhere can never silently
  // change what this row claims was sent, and so a human reviewing an
  // UNCERTAIN/FAILED row sees exactly what was attempted, not whatever
  // the order looks like now.
  submittedSnapshot Json

  // Populated only once SAP has actually confirmed success -- never
  // written speculatively. externalDocEntry unique when present (Postgres
  // permits any number of NULLs through a unique index), mirroring
  // SapInvoice.sapDocEntry's own pattern -- this is also the physical
  // guard behind findSalesOrderByExternalReference (spec section 5.1).
  externalDocEntry String? @unique
  externalDocNum   String?

  attemptCount  Int       @default(0)
  lastAttemptAt DateTime?

  lastErrorCategory IntegrationErrorCategory?
  lastErrorMessage  String? // sanitized -- never a raw secret or full stack trace

  // Set once this row reaches a terminal, resolved state: SUCCEEDED, a
  // FAILED row a human has acknowledged, or an UNCERTAIN row a human has
  // manually reconciled (linked to a found SAP document, or confirmed
  // genuinely never created). Null while still PENDING/PROCESSING or
  // while an UNCERTAIN/FAILED row still needs attention.
  resolvedAt DateTime?

  isDemo Boolean @default(false)

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  syncJob       IntegrationSyncJob? @relation(fields: [syncJobId], references: [id], onDelete: Restrict)
  customerOrder CustomerOrder       @relation(fields: [customerOrderId], references: [id], onDelete: Restrict)

  @@index([status])
  @@index([syncJobId])
  @@index([isDemo])
}

// =============================================================================
// Milestone 10 (Communication Channels & Fulfilment). Connects SalesFlow's
// existing sales/quotation/order/approval/SAP workflows to customer
// communication channels (email, WhatsApp) and structured dispatch/delivery
// fulfilment. See docs/milestones/PROGRESS.md's Milestone 10 section for the
// full design write-up this schema implements.
//
// Three genuinely new subsystems, reusing everything that already exists
// (spec's own "do not duplicate" instruction):
//   1. Inbound intake review (MessageIntake/MessageAttachment) -- the PO
//      EXTRACTION pipeline itself is NOT rebuilt here: lib/po-intake.ts's
//      createPoIntake() already accepts { submission: "paste", channel:
//      "EMAIL" | "WHATSAPP", pastedText }, built in Milestone 2A.
//      MessageIntake is purely the pre-extraction holding/review layer a
//      webhook (or a manual-fallback form) writes into, so an inbound
//      message can be received with NO human-attributed write at all --
//      the same problem M9 hit with OrderDocument.uploadedById being
//      required is avoided by deferring that requirement to the moment a
//      real signed-in reviewer actively converts, links, or ignores a
//      row, never at receipt time.
//   2. Outbound customer communication (OutboundMessage) -- did not exist
//      before this milestone at all (lib/notifications/create.ts's own
//      header comment explicitly deferred it here). Deliberately LIGHTER
//      than IntegrationOperation: QUEUED -> SENT | FAILED only, no
//      UNCERTAIN state, because an email/WhatsApp send failure is a plain
//      HTTP-level failure/rejection, never the "did SAP actually receive
//      this" ambiguity a dropped connection to an ERP creates.
//   3. Dispatch/delivery fulfilment (DispatchRecord/DispatchLine/
//      DeliveryRecord/DeliveryLine) -- also did not exist before. Given
//      its own, separate lifecycle rather than extending OrderStatus,
//      following the exact precedent PickingSessionStatus and
//      IntegrationOperationStatus already set (see docs/milestones/
//      ROADMAP.md's "Things to never conflate").
//
// Deliberately NOT a generic polymorphic entityType/entityId system (the
// same explicit anti-pattern IntegrationOperation's own comment calls out
// above): OutboundMessage.relatedOrderId/relatedQuotationId/
// relatedDispatchRecordId/relatedDeliveryRecordId are real, typed,
// optional foreign keys onto the exact four business objects a customer
// communication can concern, not a generic reference row.
//
// A deliberate, documented trade-off: unlike the notification system's own
// same-transaction dual-write convention (lib/notifications/create.ts),
// OutboundMessage rows are NOT queued inside the existing lib/quotations/
// issue.ts, lib/quotations/convert-to-order.ts, or
// lib/picking/authorize-picking.ts transactions. They are queued from the
// thin API route handler immediately AFTER each existing lib call returns
// success, in a non-blocking try/catch -- a smaller blast radius against
// already-shipped M3/M7/M8 code, at the cost of a (rare, and itself
// FAILED-tracked rather than silently lost) window where the business
// event commits but the queue write does not. See lib/communications/
// send.ts's own comment.
// =============================================================================

// Which channel a message arrived on or will be sent on. Deliberately a
// SEPARATE enum from OrderSource even though the names overlap -- the same
// "give a new lifecycle/dimension its own enum rather than overloading an
// existing one" precedent PickingSessionStatus already set against
// OrderStatus. OrderSource answers "how did this PO arrive" (and also
// carries PDF/IMAGE/EXCEL/CSV/QUOTATION values that have no meaning for a
// communication channel); MessageChannel answers "which messaging channel"
// for both an inbound MessageIntake and an outbound OutboundMessage.
// MANUAL covers the explicit "manual intake fallback where no authorised
// integration exists" the spec requires (point 2) -- e.g. a customer phoned
// in or messaged WhatsApp before a WhatsApp Business API connection exists,
// and a staff member keys in what was said.
enum MessageChannel {
  EMAIL
  WHATSAPP
  MANUAL
}

// RECEIVED: created by a channel webhook or the manual-intake form,
// awaiting human review -- NEVER auto-advanced past this by any scheduled
// job or webhook handler itself (spec point 1's "support human review
// before creating or confirming commercial transactions"). CONVERTED: a
// reviewer called lib/po-intake.ts's createPoIntake() against this row's
// stored text/attachments, producing a real OrderDocument (resultingOrder
// DocumentId set). LINKED: a reviewer tied this message to an ALREADY-
// EXISTING order or quotation as a follow-up communication (e.g. "where is
// my delivery"), never creating a new PO. IGNORED: a reviewer determined
// this is not a commercial transaction at all (spam, general chat, already
// handled elsewhere). DUPLICATE: a reviewer (or, when the channel API
// supplies a stable externalMessageId, the receiving webhook itself)
// determined this is a re-delivery of an already-seen message --
// duplicateOfId records which one, never silently dropped.
enum MessageIntakeStatus {
  RECEIVED
  CONVERTED
  LINKED
  IGNORED
  DUPLICATE
}

// One per customer-facing event this milestone actually sends.
// QUOTATION_ISSUED / ORDER_CONFIRMATION fire from the existing
// app/api/quotations/[id]/issue and .../convert-to-order route handlers
// (spec point 3's "quotation communication" / "order confirmations").
// QUOTATION_RESPONSE_ACKNOWLEDGED fires when staff record a customer's
// accept/reject in lib/quotations/respond.ts -- the acknowledgement always
// originates from SalesFlow confirming receipt; the customer's own
// accept/reject message itself, if it arrived by email/WhatsApp, is a
// MessageIntake, never an OutboundMessage. PICKING_UPDATE fires from
// lib/picking/authorize-picking.ts (spec's "picking and fulfilment
// updates"). DISPATCH_NOTIFICATION / DELIVERY_CONFIRMATION /
// DELIVERY_EXCEPTION fire from lib/fulfilment/dispatch.ts and
// lib/fulfilment/delivery.ts (DELIVERY_EXCEPTION only when
// DeliveryRecord.outcome is not ACCEPTED_IN_FULL).
enum OutboundMessageType {
  QUOTATION_ISSUED
  QUOTATION_RESPONSE_ACKNOWLEDGED
  ORDER_CONFIRMATION
  PICKING_UPDATE
  DISPATCH_NOTIFICATION
  DELIVERY_CONFIRMATION
  DELIVERY_EXCEPTION
}

// Deliberately LIGHTER than IntegrationOperationStatus (see the Milestone
// 10 header comment above for why) -- QUEUED: created, not yet attempted.
// SENT: the channel adapter (mock or real) confirmed acceptance. FAILED: a
// permanent send failure (bad address, provider rejection, adapter
// configuration error) -- never auto-retried; corrected and resent, or
// handled by a phone call, by a human (lib/communications/dispatcher.ts
// never transitions FAILED back to QUEUED on its own).
enum OutboundMessageStatus {
  QUEUED
  SENT
  FAILED
}

// A DispatchRecord's own lifecycle -- deliberately separate from
// OrderStatus, which stops at READY_TO_INVOICE/REJECTED/CANCELLED and is
// never extended here, the same precedent PickingSessionStatus and
// IntegrationOperationStatus already set. PLANNED: created, not yet left
// the warehouse. DEPARTED: vehicle/courier has left (departedById/
// departedAt set). DELIVERED: set the moment this dispatch's one
// DeliveryRecord is created (lib/fulfilment/delivery.ts sets both in the
// same transaction) -- DeliveryRecord.recordedAt remains the authoritative
// timestamp; this status value exists only so a dispatch list query never
// has to join DeliveryRecord just to filter out completed dispatches.
// CANCELLED: called off before departure (cancelledById/cancelledAt/
// cancellationReason set) -- a dispatch already DEPARTED or DELIVERED can
// never be cancelled (enforced in lib/fulfilment/dispatch.ts, not here).
enum DispatchStatus {
  PLANNED
  DEPARTED
  DELIVERED
  CANCELLED
}

// Recorded per DeliveryRecord (header-level outcome; DeliveryLine below
// carries the per-order-line accepted/rejected split that always sums
// consistently with this value). ACCEPTED_IN_FULL: every DeliveryLine's
// rejectedQuantity is zero. PARTIALLY_REJECTED: at least one DeliveryLine
// has both acceptedQuantity > 0 and rejectedQuantity > 0, or the mix across
// lines is otherwise not all-or-nothing. FULLY_REJECTED: every
// DeliveryLine's acceptedQuantity is zero (spec point 4's "rejected
// quantities" case, e.g. the whole load refused at the gate).
enum DeliveryOutcome {
  ACCEPTED_IN_FULL
  PARTIALLY_REJECTED
  FULLY_REJECTED
}

// One row per inbound email or WhatsApp message (or manually-keyed
// fallback entry) received, BEFORE any human review. Created by a channel
// webhook route handler (app/api/channels/email/webhook, app/api/channels/
// whatsapp/webhook) with no User at all -- reviewedById stays null until a
// real signed-in reviewer acts on it, which is what makes "support human
// review before creating or confirming commercial transactions" (spec
// point 1) a structural fact rather than a convention: nothing in this
// milestone ever calls createPoIntake() or links an order/quotation
// without a genuine reviewer.id in hand.
//
// customerId/customerContactId are SUGGESTED matches only (lib/channels/
// match-customer.ts, matched by the raw fromAddress against Customer.email/
// phone and CustomerContact.email/phone) -- never auto-confirmed, and a
// reviewer can accept, change, or clear the suggestion at review time. This
// is the same "never silently guess" principle the existing invoice-
// reconciliation matcher already follows (see User's own Milestone 5
// comment above).
model MessageIntake {
  id String @id @default(cuid())

  channel MessageChannel

  // The provider's own message id (an email Message-ID header value, or a
  // WhatsApp wamid) when the channel supplies one -- the DB-level
  // duplicate-prevention guard (spec point 1's "avoid duplicate intake"):
  // a webhook redelivering the same message can never create a second
  // row. Null for MANUAL intake, which has no such id; duplicate detection
  // there is a human reviewer's job (status DUPLICATE, duplicateOfId set).
  externalMessageId String? @unique

  fromAddress     String // raw sender email address or WhatsApp phone number, exactly as received
  fromDisplayName String?

  subject  String? // email only; null for WHATSAPP/MANUAL
  bodyText String? // plain-text body/message content, preserved verbatim -- same "preserve the customer's own words" principle as CustomerOrder.originalSourceText

  // The full raw webhook payload, for audit/debugging -- inbound customer
  // data, never a credential or secret (those live only in environment
  // variables, same as every other integration in this project).
  rawPayload Json?

  // The provider's own timestamp for when the message was actually sent,
  // when available; falls back to createdAt (webhook receipt time) for
  // MANUAL intake or a provider that supplies none.
  receivedAt DateTime @db.Timestamptz(6)

  customerId        String?
  customerContactId String?

  status MessageIntakeStatus @default(RECEIVED)

  reviewedById String?
  reviewedAt   DateTime? @db.Timestamptz(6)
  reviewNotes  String? // staff-only commentary on why converted/linked/ignored/marked duplicate

  // Set only when status is CONVERTED. @unique: at most one OrderDocument
  // is ever created from a given intake, the same structural duplicate-
  // order guard Quotation.convertedOrderId already uses.
  resultingOrderDocumentId String? @unique

  // Set only when status is LINKED -- a follow-up communication tied to an
  // already-existing order or quotation, never a new PO. At most one of
  // these two is ever set on a given row (enforced in
  // lib/channels/intake-review.ts, not the schema, the same way other
  // cross-field business rules in this project are enforced in lib/).
  linkedOrderId     String?
  linkedQuotationId String?

  // Set only when status is DUPLICATE -- self-relation to the original,
  // earlier MessageIntake this row repeats.
  duplicateOfId String?

  isDemo Boolean @default(false)

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  customer        Customer?        @relation(fields: [customerId], references: [id], onDelete: SetNull)
  customerContact CustomerContact? @relation(fields: [customerContactId], references: [id], onDelete: SetNull)
  reviewedBy      User?            @relation("MessageIntakeReviewer", fields: [reviewedById], references: [id], onDelete: Restrict)

  resultingOrderDocument OrderDocument? @relation(fields: [resultingOrderDocumentId], references: [id], onDelete: Restrict)
  linkedOrder            CustomerOrder? @relation(fields: [linkedOrderId], references: [id], onDelete: Restrict)
  linkedQuotation        Quotation?     @relation(fields: [linkedQuotationId], references: [id], onDelete: Restrict)

  duplicateOf       MessageIntake?  @relation("MessageIntakeDuplicate", fields: [duplicateOfId], references: [id], onDelete: Restrict)
  duplicatesOfThis  MessageIntake[] @relation("MessageIntakeDuplicate")

  attachments MessageAttachment[]

  @@index([channel])
  @@index([status])
  @@index([customerId])
  @@index([receivedAt])
  @@index([isDemo])
}

// Files attached to an inbound MessageIntake (PDF/Excel/image attachments
// per spec point 1) -- stored via the EXISTING lib/storage/ StorageDriver
// (same key-based put/get/delete interface M0's OrderDocument already
// uses), no second storage mechanism introduced. Cascade on its parent: an
// attachment has no independent meaning once the message row it belongs to
// is gone (this app never actually deletes a MessageIntake through any UI
// path, so this is a safety net, not an expected occurrence -- same
// reasoning as Notification's own onDelete: Cascade above).
model MessageAttachment {
  id              String @id @default(cuid())
  messageIntakeId String

  originalFileName String
  storageKey       String  @unique
  mimeType         String
  fileSize         BigInt
  checksum         String? // same de-duplication convention as OrderDocument.checksum

  createdAt DateTime @default(now()) @db.Timestamptz(6)

  messageIntake MessageIntake @relation(fields: [messageIntakeId], references: [id], onDelete: Cascade)

  @@index([messageIntakeId])
}

// The outbox for every customer-facing communication this milestone sends
// (spec point 5's "durable message queue/outbox"). bodyText is the FULLY
// RENDERED message, captured immutably at queue time (lib/communications/
// templates.ts) -- the same "preserve exactly what was sent/will be sent"
// principle IntegrationOperation.submittedSnapshot already follows, so a
// later Resend of a FAILED row always re-sends this identical text, never
// a re-render against whatever the underlying order/quotation looks like
// by then.
//
// idempotencyKey is deterministic, never random: "MSG-<type>-<entityId>"
// for an event that can only ever happen once per entity (QUOTATION_ISSUED,
// ORDER_CONFIRMATION, QUOTATION_RESPONSE_ACKNOWLEDGED), or
// "MSG-<type>-<dispatchOrDeliveryRecordId>" for a per-dispatch/per-delivery
// event (DISPATCH_NOTIFICATION, DELIVERY_CONFIRMATION, DELIVERY_EXCEPTION)
// -- the @unique constraint is the physical duplicate-send guard (spec
// point 5's "duplicate prevention"), mirroring IntegrationOperation.
// idempotencyKey's own role exactly.
model OutboundMessage {
  id String @id @default(cuid())

  type    OutboundMessageType
  channel MessageChannel
  status  OutboundMessageStatus @default(QUEUED)

  idempotencyKey String @unique

  customerId        String
  customerContactId String?

  // Resolved recipient address/number, snapshotted at queue time. Null
  // only for channel MANUAL, where there is nothing to send electronically
  // and a staff member must phone the customer instead (spec point 2's
  // "do not pretend WhatsApp is connected when it is not" -- the same
  // honesty applies here: if no address/number is on file, this row says
  // so rather than silently queuing an unsendable message).
  toAddress String?

  subject  String?
  bodyText String

  // Optional, typed cross-references to the exact business object this
  // communication concerns -- deliberately NOT a generic polymorphic
  // entityType/entityId system (see the Milestone 10 header comment
  // above). At most one is ever set for a given row in practice, decided
  // by `type`.
  relatedOrderId          String?
  relatedQuotationId       String?
  relatedDispatchRecordId  String?
  relatedDeliveryRecordId  String?

  attemptCount     Int       @default(0)
  lastAttemptAt    DateTime?
  lastErrorMessage String? // sanitized -- never a raw secret or full stack trace, same convention as IntegrationOperation.lastErrorMessage
  sentAt           DateTime?

  // Who performed the action that caused this row to be queued (e.g. the
  // salesperson who clicked "Issue quotation"). Required: unlike
  // IntegrationSyncJob.triggeredById, nothing in this milestone queues an
  // OutboundMessage from an unattended/scheduled path -- every trigger
  // point is a route handler already behind requireUserOrResponse().
  triggeredById String

  // Set only by the explicit manual Resend action (SALES_MANAGER/
  // ADMINISTRATOR only -- see app/api/communications/[id]/resend/route.ts)
  // against a FAILED row. Distinct from triggeredById so the record never
  // loses who ORIGINALLY caused this communication, even after a later
  // resend by someone else.
  lastResentById String?
  lastResentAt   DateTime?

  isDemo Boolean @default(false)

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  customer        Customer         @relation(fields: [customerId], references: [id], onDelete: Restrict)
  customerContact CustomerContact? @relation(fields: [customerContactId], references: [id], onDelete: SetNull)

  relatedOrder          CustomerOrder?  @relation(fields: [relatedOrderId], references: [id], onDelete: SetNull)
  relatedQuotation      Quotation?      @relation(fields: [relatedQuotationId], references: [id], onDelete: SetNull)
  relatedDispatchRecord DispatchRecord? @relation(fields: [relatedDispatchRecordId], references: [id], onDelete: SetNull)
  relatedDeliveryRecord DeliveryRecord? @relation(fields: [relatedDeliveryRecordId], references: [id], onDelete: SetNull)

  triggeredBy  User  @relation("OutboundMessageTrigger", fields: [triggeredById], references: [id], onDelete: Restrict)
  lastResentBy User? @relation("OutboundMessageResender", fields: [lastResentById], references: [id], onDelete: Restrict)

  @@index([status])
  @@index([customerId])
  @@index([type])
  @@index([relatedOrderId])
  @@index([relatedQuotationId])
  @@index([isDemo])
}

// One row per dispatch ATTEMPT against an order -- deliberately one-to-
// many with CustomerOrder (not a singleton), the same "support partial
// fulfilment" requirement (spec point 4) PickingSession's own one-to-many
// relationship with CustomerOrder already established for re-picks.
// Eligibility (an order must be OrderStatus.READY_TO_INVOICE before its
// first DispatchRecord can be created) is enforced in
// lib/fulfilment/dispatch.ts, not the schema, the same way every other
// cross-model business rule in this project is enforced in lib/.
model DispatchRecord {
  id      String         @id @default(cuid())
  orderId String
  status  DispatchStatus @default(PLANNED)

  // Optional link to the specific AUTHORIZED PickingSession this dispatch's
  // quantities were sourced from -- same optional-traceability pattern as
  // OrderHandover.pickingSessionId.
  pickingSessionId String?

  // Free text -- a truck registration, a courier company name, or similar.
  // No fleet-management system is assumed or invented (spec's explicit
  // "do not invent external integrations" applies just as much to an
  // imaginary logistics platform as to WhatsApp/email).
  vehicleOrCourierReference String?

  plannedDepartureAt DateTime? @db.Timestamptz(6)

  departedById String?
  departedAt   DateTime? @db.Timestamptz(6)

  cancelledById      String?
  cancelledAt        DateTime? @db.Timestamptz(6)
  cancellationReason String?

  notes String?

  createdById String

  isDemo Boolean @default(false)

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  order          CustomerOrder   @relation(fields: [orderId], references: [id], onDelete: Restrict)
  pickingSession PickingSession? @relation(fields: [pickingSessionId], references: [id], onDelete: SetNull)

  createdBy   User  @relation("DispatchRecordCreator", fields: [createdById], references: [id], onDelete: Restrict)
  departedBy  User? @relation("DispatchRecordDeparter", fields: [departedById], references: [id], onDelete: Restrict)
  cancelledBy User? @relation("DispatchRecordCanceller", fields: [cancelledById], references: [id], onDelete: Restrict)

  lines            DispatchLine[]
  deliveryRecord   DeliveryRecord?
  outboundMessages OutboundMessage[]

  @@index([orderId])
  @@index([status])
  @@index([isDemo])
}

// Which OrderLine(s) a given DispatchRecord actually covers, and how much
// of each -- this, not a duplicated quantity on DeliveryLine, is the
// single source of truth for "how much of this order line has been
// dispatched so far" (lib/fulfilment/queries.ts's getOrderFulfilmentStatus
// sums this across every non-CANCELLED dispatch for the order). Outstanding
// quantity is derived, never stored: PickingLine.foundQuantity minus the
// sum of this line's dispatchedQuantity across all of the order line's
// DispatchLine rows -- the same "derive, don't duplicate" principle
// OrderHandover's own comment already states for its row content.
model DispatchLine {
  id               String  @id @default(cuid())
  dispatchRecordId String
  orderLineId      String

  dispatchedQuantity Decimal @db.Decimal(18, 4)

  createdAt DateTime @default(now()) @db.Timestamptz(6)

  dispatchRecord DispatchRecord @relation(fields: [dispatchRecordId], references: [id], onDelete: Cascade)
  orderLine      OrderLine      @relation(fields: [orderLineId], references: [id], onDelete: Restrict)

  deliveryLine DeliveryLine?

  @@unique([dispatchRecordId, orderLineId])
  @@index([orderLineId])
}

// One row per DispatchRecord (@unique dispatchRecordId) recording how that
// dispatch's delivery actually went -- accepted in full, partially
// rejected, or fully rejected (spec point 4's "shortages, substitutions,
// rejected quantities and delivery exceptions"). Creating this row is the
// one and only thing that moves its DispatchRecord to DispatchStatus.
// DELIVERED (lib/fulfilment/delivery.ts, same transaction). Never corrupts
// the original OrderLine/PickingLine records it derives from -- a
// rejection is recorded here, on DeliveryLine, and surfaced to the UI as a
// "File a claim" link into the EXISTING /invoice-claims/new flow (spec's
// claims workflow, Milestone 6A) rather than this model ever creating an
// InvoiceClaim itself: a claim is anchored to an SAP invoice (InvoiceClaim.
// customerOrderId is only "where possible, the original SalesFlow order"),
// which usually does not exist yet at delivery time.
model DeliveryRecord {
  id               String          @id @default(cuid())
  dispatchRecordId String          @unique
  outcome          DeliveryOutcome

  recordedById String
  recordedAt   DateTime @default(now()) @db.Timestamptz(6)

  recipientName String? // who signed/received at the customer site, if given

  // Proof-of-delivery photo/signature capture, via the existing
  // lib/storage/ StorageDriver -- same key-based convention as every other
  // stored file in this schema, no second storage mechanism.
  proofPhotoStorageKey     String?
  proofSignatureStorageKey String?

  notes String?

  isDemo Boolean @default(false)

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  dispatchRecord DispatchRecord @relation(fields: [dispatchRecordId], references: [id], onDelete: Restrict)
  recordedBy     User           @relation("DeliveryRecordRecorder", fields: [recordedById], references: [id], onDelete: Restrict)

  lines            DeliveryLine[]
  outboundMessages OutboundMessage[]

  @@index([outcome])
  @@index([isDemo])
}

// Per-DispatchLine delivery outcome -- one row per DispatchLine
// (@unique dispatchLineId), never duplicating orderLineId (derived via
// dispatchLine.orderLineId, same "derive, don't duplicate" principle as
// DispatchLine's own comment). acceptedQuantity + rejectedQuantity must
// equal that DispatchLine's dispatchedQuantity (enforced in
// lib/fulfilment/delivery.ts, not the schema). rejectionReason is free
// text -- "shortage", "damaged in transit", "wrong item substituted", etc.
// -- never a closed enum, since Zimbabwe field conditions produce reasons
// no fixed list would anticipate.
model DeliveryLine {
  id               String  @id @default(cuid())
  deliveryRecordId String
  dispatchLineId   String  @unique

  acceptedQuantity Decimal @db.Decimal(18, 4)
  rejectedQuantity Decimal @db.Decimal(18, 4) @default(0)
  rejectionReason  String?

  createdAt DateTime @default(now()) @db.Timestamptz(6)

  deliveryRecord DeliveryRecord @relation(fields: [deliveryRecordId], references: [id], onDelete: Cascade)
  dispatchLine   DispatchLine   @relation(fields: [dispatchLineId], references: [id], onDelete: Restrict)

  @@index([deliveryRecordId])
}
